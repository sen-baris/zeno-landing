---
import type { Locale } from '../lib/i18n/locales';
import { createPageLocale, agentStartingPointCopy } from '../lib/i18n/page-copy';

const { locale } = Astro.props;
const { text: t, path: withBase } = createPageLocale(locale);
import Glyph from './Glyph.astro';
import { illustrativeAdoptionScenario } from '../lib/content/illustrative-adoption';

interface Props {
  locale: Locale;
  buildStartingPoint: string;
}

const { buildStartingPoint } = Astro.props;
const buildCopy = agentStartingPointCopy[locale];
if (buildCopy.before + buildCopy.text + buildCopy.after !== t(buildStartingPoint)) {
  throw new Error('The emphasized starting-point copy must match its approved claim.');
}

const connectorAssets = [
  { name: 'Outlook', src: '/connector-logos/outlook.svg' },
  { name: 'SharePoint', src: '/connector-logos/sharepoint.svg' },
  { name: 'Salesforce', src: '/connector-logos/salesforce.svg' },
] as const;

const storySteps = [
  {
    id: 'find',
    number: '01',
    title: 'We find the workflow with you',
    body: 'The monthly finance report is important and still assembled by hand.',
    accessibleDetail:
      'The Finance report is selected from three candidate workflows. It runs every month, is assembled by hand and is owned by Finance.',
  },
  {
    id: 'build',
    number: '02',
    title: 'We build the agent with you',
    emphasis: {
      ...buildCopy,
      after: `${buildCopy.after} ${t('We connect your systems. Your team reviews and approves.')}`,
    },
    accessibleDetail:
      'The Finance report agent begins from a prebuilt finance agent or a custom build. Zeno and the team connect Outlook, SharePoint and Salesforce. The agent prepares a draft for human review and approval. The workspace shows source permissions, approved models and EU hosting.',
  },
  {
    id: 'adopt',
    number: '03',
    title: 'We stay through adoption',
    body: 'After launch, we track return use and improve before expanding.',
    accessibleDetail:
      'The Finance report agent shows rising weekly activity. More teams return and fewer seats remain inactive after launch.',
  },
] as const;

const workflows = [
  { label: 'Finance report', selected: true },
  { label: 'Supplier contract', selected: false },
  { label: 'Project updates', selected: false },
] as const;

const selectionReasons = ['Every month', 'Assembled by hand', 'Owned by Finance'] as const;

const adoptionWeeks = illustrativeAdoptionScenario.series.values;
const adoptionPeak = Math.max(...adoptionWeeks);
const controls = ['Source permissions', 'IT-approved models', 'Human approval'] as const;
---

{
  /*
  The narrative list owns the meaning and stays readable in every mode. On a wide, tall,
  motion-enabled viewport the complete story scene stays pinned while its narrative and supporting
  visual advance together; in every other environment the same three finished stages form one
  static sequence.

  The adoption shape is qualitative: the synthetic series controls only the relative bar heights,
  while no scenario figure is exposed as visible or assistive content.
*/
}
<figure
  class="hero-journey"
  data-journey="static"
  data-stage="find"
  data-reveal
  aria-labelledby="hero-journey-caption"
>
  <div class="hj-layout">
    <ol class="hj-story" aria-label={t('From first workflow to adoption')}>
      {
        storySteps.map((step) => (
          <li data-story-step={step.id}>
            <span class="item-number">{t(step.number)}</span>
            <p class="hj-story-title">{t(step.title)}</p>
            <p>
              {'emphasis' in step ? (
                <>
                  {step.emphasis.before}
                  <strong>{step.emphasis.text}</strong>
                  {step.emphasis.after}
                </>
              ) : (
                t(step.body)
              )}
            </p>
            <span class="visually-hidden">{t(step.accessibleDetail)}</span>
          </li>
        ))
      }
    </ol>

    <div class="hj-visual" aria-hidden="true">
      <div class="hj-progress">
        {
          storySteps.map((step, index) => (
            <>
              <div class="hj-progress-node" data-progress-node={step.id}>
                <span>{t(step.number)}</span>
                <b>{t(step.title)}</b>
              </div>
              {index < storySteps.length - 1 && (
                <span class="hj-progress-segment" data-progress-segment={index + 1}>
                  <i />
                </span>
              )}
            </>
          ))
        }
      </div>

      <div class="product-frame hj-frame">
        <div class="hj-panels">
          <section class="hj-panel" data-stage-panel="find" data-current>
            <header class="hj-panel-heading">
              <div>
                <p class="product-label">{t('01 / Find')}</p>
                <p class="hj-panel-title">{t('Choose the first workflow')}</p>
              </div>
              <span class="hj-status">{t('First workflow selected')}</span>
            </header>
            <div class="hj-panel-body hj-find">
              <div class="hj-find-shortlist">
                <p class="product-label">{t('Workflow shortlist')}</p>
                <ul>
                  {
                    workflows.map((workflow) => (
                      <li data-selected={String(workflow.selected)}>
                        <span>{t(workflow.selected ? '✓' : '')}</span>
                        <b>{t(workflow.label)}</b>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="hj-selection-summary">
                <div>
                  <p class="product-label">{t('Selected workflow')}</p>
                  <p class="hj-selection-title">{t('Finance report')}</p>
                </div>
                <ul>
                  {
                    selectionReasons.map((reason) => (
                      <li>
                        <span>✓</span>
                        {t(reason)}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </section>

          <section class="hj-panel" data-stage-panel="build">
            <header class="hj-panel-heading">
              <div>
                <p class="product-label">{t('02 / Build')}</p>
                <p class="hj-panel-title">{t('Finance report agent')}</p>
              </div>
              <div class="hj-starting-point">
                <span class="hj-status">{t('Prebuilt agent')}</span>
                <small>{t('or')}</small>
                <span>{t('Custom built')}</span>
              </div>
            </header>
            <div class="hj-panel-body hj-build">
              <div class="hj-build-document">
                <div class="hj-build-document-head">
                  <p class="product-label">{t('Current task')}</p>
                  <span>{t('Draft ready')}</span>
                </div>
                <p class="hj-task">{t('Draft the monthly finance report.')}</p>
                <div class="hj-document-preview">
                  <span></span>
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
              <div class="hj-build-side">
                <div class="hj-connected">
                  <p class="product-label">{t('Connected systems')}</p>
                  <ul>
                    {
                      connectorAssets.map((connector) => (
                        <li>
                          <img
                            src={withBase(connector.src)}
                            alt={t(connector.name)}
                            width="24"
                            height="24"
                            loading="eager"
                            decoding="async"
                          />
                        </li>
                      ))
                    }
                  </ul>
                </div>
                <p class="hj-approval">
                  <span>{t('Owner review')}</span>
                  <b>{t('Human approval required')}</b>
                </p>
              </div>
            </div>
          </section>

          <section class="hj-panel" data-stage-panel="adopt">
            <header class="hj-panel-heading">
              <div>
                <p class="product-label">{t('Finance report agent')}</p>
                <p class="hj-panel-title">{t('Adoption')}</p>
              </div>
              <span class="hj-status hj-status-healthy"
                >{t(illustrativeAdoptionScenario.health)}</span
              >
            </header>
            <div class="hj-panel-body hj-adoption">
              <div class="hj-chart">
                <div class="hj-chart-heading">
                  <div>
                    <p class="product-label">{t('Weekly activity')}</p>
                    <span>{t('Since launch')}</span>
                  </div>
                </div>
                <div class="hj-chart-plot">
                  {
                    adoptionWeeks.map((week) => (
                      <span style={`--column-height: ${Math.round((week / adoptionPeak) * 100)}%`}>
                        <i />
                      </span>
                    ))
                  }
                </div>
                <div class="hj-chart-axis">
                  <span>{t('Launch')}</span>
                  <span>{t('Now')}</span>
                </div>
              </div>
              <ul class="hj-adoption-stats">
                <li>
                  <p class="product-label">{t('Teams returning')}</p>
                  <strong>{t('Growing')}</strong>
                </li>
                <li>
                  <p class="product-label">{t('Inactive seats')}</p>
                  <strong>{t('Falling')}</strong>
                </li>
              </ul>
            </div>
          </section>
        </div>

        <div class="hw-governance">
          <div class="hw-governance-title">
            <p class="product-label">{t('Governed workspace')}</p>
          </div>
          <ul class="hw-controls">
            {
              controls.map((control) => (
                <li>
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <circle cx="8" cy="8" r="7" />
                    <path d="m4.8 8.2 2.2 2.2 4.2-4.6" />
                  </svg>
                  {t(control)}
                </li>
              ))
            }
          </ul>
          <span class="hw-europe">
            <Glyph name="eu" class="hw-europe-stars" />
            {t('Built for Europe')}
          </span>
        </div>
      </div>
    </div>
  </div>

  <figcaption id="hero-journey-caption" class="visually-hidden">
    {
      t(
        'The Finance report agent moves from workflow selection to a prebuilt or custom starting point. Zeno and the team connect company systems, review the draft and improve adoption after launch.',
      )
    }
  </figcaption>
</figure>

<script>
  import { observeSceneFit, sceneContentFits } from '../lib/motion/scene-fit';
  const journey = document.querySelector<HTMLElement>('.hero-journey');

  if (journey) {
    const root = document.documentElement;
    const scene = journey.querySelector<HTMLElement>('.hj-layout');
    const steps = Array.from(journey.querySelectorAll<HTMLElement>('[data-story-step]'));
    const panels = Array.from(journey.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    const viewport = window.matchMedia('(min-width: 1101px) and (min-height: 720px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let enhanced = false;
    let queuedFrame: number | undefined;

    const show = (index: number) => {
      const nextStep = steps[index];
      if (!nextStep) return;

      const stage = nextStep.dataset.storyStep;
      if (!stage) return;

      journey.dataset.stage = stage;
      for (const [position, step] of steps.entries()) {
        step.toggleAttribute('data-current', position === index);
      }
      for (const [position, panel] of panels.entries()) {
        panel.toggleAttribute('data-current', position === index);
      }
    };

    const update = () => {
      queuedFrame = undefined;
      if (!enhanced || !scene || steps.length === 0) return;

      const journeyRect = journey.getBoundingClientRect();
      const sceneRect = scene.getBoundingClientRect();
      const stickyTop = Number.parseFloat(getComputedStyle(scene).top) || 0;
      const travel = Math.max(1, journeyRect.height - sceneRect.height);
      const progress = Math.min(1, Math.max(0, (stickyTop - journeyRect.top) / travel));
      const current = Math.min(steps.length - 1, Math.floor(progress * steps.length));

      journey.style.setProperty('--segment-one', String(Math.min(1, progress * 3)));
      journey.style.setProperty(
        '--segment-two',
        String(Math.min(1, Math.max(0, (progress - 1 / 3) * 3))),
      );
      show(current);
    };

    const queueUpdate = () => {
      if (!enhanced || queuedFrame !== undefined) return;
      queuedFrame = window.requestAnimationFrame(update);
    };

    const stop = () => {
      if (!enhanced) return;
      enhanced = false;
      window.removeEventListener('scroll', queueUpdate);
      window.removeEventListener('resize', queueUpdate);
      if (queuedFrame !== undefined) window.cancelAnimationFrame(queuedFrame);
      queuedFrame = undefined;
      journey.dataset.journey = 'static';
      journey.dataset.stage = 'find';
      journey.style.removeProperty('--segment-one');
      journey.style.removeProperty('--segment-two');
      for (const step of steps) step.removeAttribute('data-current');
      for (const panel of panels) panel.removeAttribute('data-current');
    };

    const start = () => {
      if (enhanced) return;
      enhanced = true;
      journey.dataset.journey = 'on';
      window.addEventListener('scroll', queueUpdate, { passive: true });
      window.addEventListener('resize', queueUpdate, { passive: true });
      update();
    };

    const sync = () => {
      const canEnhance =
        viewport.matches && !reducedMotion.matches && root.getAttribute('data-motion') === 'on';
      if (canEnhance) {
        start();
        const content = Array.from(journey.querySelectorAll<HTMLElement>('.hj-story, .hj-visual'));
        if (!sceneContentFits(content, window.innerHeight - 76, panels)) stop();
      } else stop();
    };

    viewport.addEventListener('change', sync);
    reducedMotion.addEventListener('change', sync);
    const stopObservingFit = observeSceneFit(sync);
    window.addEventListener(
      'pagehide',
      () => {
        stop();
        stopObservingFit();
        viewport.removeEventListener('change', sync);
        reducedMotion.removeEventListener('change', sync);
      },
      { once: true },
    );
    sync();
  }
</script>
