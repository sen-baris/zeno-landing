---
import { trustCenterUrl } from '../lib/claims/registry';
import type { Locale } from '../lib/i18n/locales';
import { getLocalizedPath, type StaticRouteKey } from '../lib/i18n/routes';
import { sharedUiCopy } from '../lib/i18n/ui';
import { withBase } from '../lib/routing/base-path';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = sharedUiCopy[locale].footer;
const route = (key: StaticRouteKey, targetLocale: Locale = locale) => {
  const path = getLocalizedPath({ kind: 'static', key }, targetLocale);
  if (!path) throw new Error(`Footer route "${key}" is unavailable for "${targetLocale}".`);
  return withBase(path);
};
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="wordmark wordmark-light" href={route('home')} aria-label="Zeno">Zeno</a>
      <p>{copy.tagline}</p>
    </div>
    <nav class="footer-navigation" aria-label={copy.navigationLabel}>
      <div class="footer-nav-group">
        <h2 class="footer-nav-label">{copy.explore}</h2>
        <ul>
          <li><a href={route('product')}>{copy.product}</a></li>
          <li><a href={route('solutions')}>{copy.solutions}</a></li>
          <li><a href={route('pricing')}>{copy.businessCase}</a></li>
        </ul>
      </div>
      <div class="footer-nav-group">
        <h2 class="footer-nav-label">{copy.company}</h2>
        <ul>
          <li><a href={`${route('home')}#why`}>{copy.why}</a></li>
          <li><a href={route('security')}>{copy.security}</a></li>
          <li>
            <a href={trustCenterUrl} target="_blank" rel="noopener noreferrer"
              >{copy.trustCenter}<span class="visually-hidden">{copy.trustCenterNewTab}</span></a
            >
          </li>
          <li><a href={route('demo')}>{copy.bookDemo}</a></li>
        </ul>
      </div>
      <div class="footer-nav-group">
        <h2 class="footer-nav-label">{copy.legal}</h2>
        <ul>
          <li>
            <a href={route('privacy', 'en')} hreflang="en">{copy.privacy}{copy.englishDocument}</a>
          </li>
          <li>
            <a href={route('terms', 'en')} hreflang="en">{copy.terms}{copy.englishDocument}</a>
          </li>
          <li>
            <a href={route('imprint', 'en')} hreflang="en">{copy.imprint}{copy.englishDocument}</a>
          </li>
        </ul>
      </div>
    </nav>
    <div class="footer-meta">
      <span>© {new Date().getFullYear()} Zeno</span>
      <span>{copy.previewLabel}</span>
    </div>
  </div>
</footer>
