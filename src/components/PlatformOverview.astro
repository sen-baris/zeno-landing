---
import { euStarsPath, euStarsViewBox } from '../lib/icons/eu-stars';

interface Props {
  platformStatement: string;
  startingPointStatement: string;
  examplesStatement: string;
  agentExamples: readonly { label: string; kind: string }[];
  modelHostingStatement: string;
  governanceStatement: string;
}

const {
  platformStatement,
  startingPointStatement,
  examplesStatement,
  agentExamples,
  modelHostingStatement,
  governanceStatement,
} = Astro.props;
const prebuiltExamples = agentExamples.filter((example) => example.kind === 'Prebuilt');
const customExample = agentExamples.find((example) => example.kind !== 'Prebuilt');
---

<figure class="platform-overview" data-reveal aria-labelledby="platform-overview-caption">
  <div class="platform-overview-frame">
    <div class="platform-overview-bar">
      <span>The enterprise AI platform</span>
      <div class="platform-hosting-claim">
        <svg
          class="platform-hosting-mark"
          viewBox={euStarsViewBox}
          aria-hidden="true"
          focusable="false"
        >
          <path d={euStarsPath}></path>
        </svg>
        <span>{modelHostingStatement}</span>
      </div>
    </div>

    <div class="platform-overview-flow">
      <section aria-labelledby="context-stage-title">
        <p class="product-label">01 / Context</p>
        <h2 id="context-stage-title">Your company context</h2>
        <ul class="stage-stack source-stack">
          <li>
            <svg class="stage-glyph" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <rect x="3" y="3" width="14" height="14" rx="3.4"></rect>
              <path d="m6.8 10.2 2.1 2.1 4.3-4.6"></path>
            </svg>
            Company knowledge
          </li>
          <li>
            <svg class="stage-glyph" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <rect x="3" y="3.6" width="14" height="5.4" rx="1.8"></rect>
              <rect x="3" y="11" width="14" height="5.4" rx="1.8"></rect>
              <path d="M6 6.3h0.01M6 13.7h0.01"></path>
            </svg>
            Business systems
          </li>
          <li>
            <svg class="stage-glyph" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <circle cx="7.6" cy="7.4" r="2.8"></circle>
              <path d="M2.9 16.5c0-2.6 2.1-4.1 4.7-4.1s4.7 1.5 4.7 4.1"></path>
              <circle cx="14.6" cy="8.7" r="2.1"></circle>
              <path d="M13.5 12.8c2.2-.2 3.6 1.2 3.6 3.7"></path>
            </svg>
            Team guidance
          </li>
        </ul>
      </section>

      <section class="platform-agent-stage" aria-labelledby="agents-stage-title">
        <p class="product-label">02 / Agents</p>
        <h2 id="agents-stage-title">Agents built for the work</h2>
        <div class="platform-agent-choices" aria-label={startingPointStatement}>
          <div data-agent-choice="prebuilt">
            <span>Prebuilt</span>
            <strong>{prebuiltExamples.map((example) => example.label).join(', ')}</strong>
          </div>
          <span class="platform-agent-or">or</span>
          <div data-agent-choice="custom">
            <span>From scratch</span>
            <strong>{customExample?.label}</strong>
          </div>
        </div>
      </section>

      <section aria-labelledby="work-stage-title">
        <p class="product-label">03 / Work</p>
        <h2 id="work-stage-title">Get the work done</h2>
        <ul class="stage-stack platform-work-list">
          <li><span>01</span>Ask in Chat</li>
          <li><span>02</span>Run agent tasks</li>
          <li><span>03</span>Build visible workflows</li>
        </ul>
      </section>
    </div>

    <div class="platform-governance">
      <div>
        <p class="product-label">One governed workspace</p>
        <p>{governanceStatement}</p>
      </div>
      <ul aria-label="Enterprise controls">
        <li>Knowledge access</li>
        <li>Model choice</li>
        <li>Human checkpoints</li>
        <li>Adoption visibility</li>
      </ul>
    </div>
  </div>
  <figcaption id="platform-overview-caption" class="visually-hidden">
    {platformStatement}{' '}{startingPointStatement}{' '}{examplesStatement}{' '}{
      modelHostingStatement
    }{' '}{governanceStatement}
  </figcaption>
</figure>
