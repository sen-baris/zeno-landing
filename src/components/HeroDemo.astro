---
// One week of work, in four beats. Illustrative product UI rather than a metaphor: someone asks,
// the agent drafts against approved sources, the same job runs again next week, and IT can see all
// of it. No figures are quoted, so nothing here needs a claims record.
const beats = [
  {
    key: 'ask',
    label: 'Ask',
    when: 'Monday, 09:00',
    title: 'Someone asks for the board update.',
    body: 'In the words they would use anyway. The agent already has the sources it is allowed.',
  },
  {
    key: 'draft',
    label: 'Draft',
    when: 'Two minutes later',
    title: 'It comes back written, with its sources attached.',
    body: 'Built from your own reporting data, in your own template, ready for someone to check.',
  },
  {
    key: 'repeat',
    label: 'Repeat',
    when: 'Every Monday after that',
    title: 'The same job runs on a schedule.',
    body: 'It collects, prepares and drafts on its own, then stops and waits for a person.',
  },
  {
    key: 'govern',
    label: 'Govern',
    when: 'All of it, all the time',
    title: 'IT can see who is using it and on what.',
    body: 'Which model, which team, and where a human still has to sign off.',
  },
] as const;
---

{
  /*
  The hero's demo. It plays where it sits: four beats on a timer, a rail to step through them, and
  no relationship to the scroll position whatsoever.

  Nothing below is applied unless the controller has confirmed support and set data-demo="on". With
  JavaScript off or reduced motion on, the four beats simply stack as an ordered list and the whole
  week is readable at once, with no rail and no control that does nothing.

  Auto-advance stops the moment anyone touches the rail, suspends while the pointer or focus is
  inside the figure, and can be stopped outright with the pause control — the mechanism WCAG 2.2.2
  asks for on anything that moves on its own for more than five seconds.
*/
}
<figure class="hero-demo" data-demo="off">
  <div class="product-frame hero-demo-frame">
    <div class="product-frame-bar">
      <div>
        <span class="product-mark" aria-hidden="true">Z</span>
        <span>Finance workspace</span>
      </div>
      <span class="product-frame-status">Governed workspace</span>
    </div>

    <ol class="hero-demo-stage" id="hero-demo-stage">
      {
        beats.map((beat, index) => (
          <li class="hero-demo-beat" data-beat={beat.key}>
            <div class="hero-demo-said">
              <p class="product-label">
                <span>{String(index + 1).padStart(2, '0')}</span>
                {beat.label} · {beat.when}
              </p>
              <p class="hero-demo-title">{beat.title}</p>
              <p class="hero-demo-body">{beat.body}</p>
            </div>

            <div class="hero-demo-shown" aria-hidden="true">
              {beat.key === 'ask' && (
                <div class="demo-ask">
                  <p class="demo-prompt">Draft the Q3 board update.</p>
                  <ul class="demo-chips">
                    <li>Finance drive</li>
                    <li>Reporting data</li>
                    <li>Board template</li>
                  </ul>
                </div>
              )}

              {beat.key === 'draft' && (
                <div class="demo-draft">
                  <ul>
                    <li>
                      <span>Revenue summary</span>
                      <i />
                    </li>
                    <li>
                      <span>Pipeline movement</span>
                      <i />
                    </li>
                    <li>
                      <span>Risks and asks</span>
                      <i />
                    </li>
                  </ul>
                  <p class="demo-note">Sources attached to every figure</p>
                </div>
              )}

              {beat.key === 'repeat' && (
                <div class="demo-repeat">
                  <p class="demo-schedule">Every Monday, 09:00</p>
                  <ol class="demo-steps">
                    <li>Collect</li>
                    <li>Prepare</li>
                    <li>Draft</li>
                    <li class="demo-step-hold">Wait for review</li>
                  </ol>
                </div>
              )}

              {beat.key === 'govern' && (
                <ul class="demo-govern">
                  <li>
                    <span>Model</span>
                    <b>Approved provider</b>
                  </li>
                  <li>
                    <span>Access</span>
                    <b>Finance team</b>
                  </li>
                  <li>
                    <span>Sign-off</span>
                    <b>Required</b>
                  </li>
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="hero-demo-rail">
    <ul>
      {
        beats.map((beat, index) => (
          <li>
            <button type="button" data-goto={index} aria-controls="hero-demo-stage">
              <span>{String(index + 1).padStart(2, '0')}</span>
              {beat.label}
            </button>
          </li>
        ))
      }
    </ul>
    <button type="button" class="hero-demo-toggle" data-toggle>Pause</button>
  </div>
</figure>

<script>
  const figure = document.querySelector<HTMLElement>('.hero-demo');
  const motionOn = document.documentElement.getAttribute('data-motion') === 'on';

  if (figure && motionOn) {
    const beats = Array.from(figure.querySelectorAll<HTMLElement>('.hero-demo-beat'));
    const gotoButtons = Array.from(figure.querySelectorAll<HTMLButtonElement>('[data-goto]'));
    const toggle = figure.querySelector<HTMLButtonElement>('[data-toggle]');
    const HOLD = 4200;

    if (beats.length > 0 && gotoButtons.length === beats.length && toggle) {
      figure.dataset.demo = 'on';

      let index = 0;
      let playing = true;
      let suspended = false;
      let timer = 0;

      const show = (next: number) => {
        index = ((next % beats.length) + beats.length) % beats.length;
        for (const [position, beat] of beats.entries()) {
          const active = position === index;
          beat.toggleAttribute('data-active', active);
          // Hidden from layout and from assistive technology both, so only the beat on screen is
          // ever read out, and re-showing one restarts its entrance.
          beat.hidden = !active;
        }
        for (const [position, button] of gotoButtons.entries()) {
          if (position === index) button.setAttribute('aria-current', 'true');
          else button.removeAttribute('aria-current');
        }
      };

      const stop = () => {
        if (timer) window.clearTimeout(timer);
        timer = 0;
      };

      const schedule = () => {
        stop();
        if (!playing || suspended) return;
        timer = window.setTimeout(() => {
          show(index + 1);
          schedule();
        }, HOLD);
      };

      const setPlaying = (next: boolean) => {
        playing = next;
        toggle.textContent = playing ? 'Pause' : 'Play';
        schedule();
      };

      for (const [position, button] of gotoButtons.entries()) {
        button.addEventListener('click', () => {
          show(position);
          // Taking hold of the rail is taking control: it would be rude to move again underneath
          // someone who just chose a beat.
          setPlaying(false);
        });
      }

      toggle.addEventListener('click', () => setPlaying(!playing));

      // Reading or pointing at it holds it still without changing what the pause control says.
      const suspend = (next: boolean) => {
        suspended = next;
        schedule();
      };
      figure.addEventListener('mouseenter', () => suspend(true));
      figure.addEventListener('mouseleave', () => suspend(false));
      figure.addEventListener('focusin', () => suspend(true));
      figure.addEventListener('focusout', (event) => {
        if (figure.contains(event.relatedTarget as Node | null)) return;
        suspend(false);
      });

      show(0);
      schedule();

      window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (event) => {
        if (!event.matches) return;
        stop();
        figure.dataset.demo = 'off';
        for (const beat of beats) {
          beat.hidden = false;
          beat.removeAttribute('data-active');
        }
        for (const button of gotoButtons) button.removeAttribute('aria-current');
      });
    }
  }
</script>
