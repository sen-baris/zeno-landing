---
export type BenefitSceneVariant = 'ask' | 'reuse' | 'oversight';

interface Props {
  variant: BenefitSceneVariant;
}

const { variant } = Astro.props;

// Each scene supports the benefit beside it and carries no information of its own, so it is
// hidden from assistive technology and the text above it remains the complete statement.
---

<div class="benefit-scene" data-scene={variant} aria-hidden="true">
  {
    variant === 'ask' && (
      <>
        <p class="product-label">Ask</p>
        <div class="scene-input">
          <span>Summarise last quarter for the leadership review</span>
          <i class="scene-caret" />
        </div>
        <div class="scene-chips">
          <span>Company knowledge</span>
          <span>Reporting data</span>
        </div>
        <div class="scene-answer">
          <i />
          <i />
          <i />
        </div>
      </>
    )
  }

  {
    variant === 'reuse' && (
      <>
        <p class="product-label">Shared agent</p>
        <div class="scene-agent">
          <span class="scene-avatar">R</span>Research Agent
        </div>
        <ul class="scene-branches">
          <li>Marketing</li>
          <li>Finance</li>
          <li>Legal</li>
        </ul>
      </>
    )
  }

  {
    variant === 'oversight' && (
      <>
        <p class="product-label">Oversight</p>
        <ul class="scene-rows">
          <li>
            Access<span>Managed</span>
          </li>
          <li>
            Model choice<span>Approved list</span>
          </li>
          <li>
            Review<span>Attached</span>
          </li>
        </ul>
      </>
    )
  }
</div>
