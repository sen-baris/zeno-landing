---
// The answer at the altitude the problem was posed: one governed layer, with the agents teams
// deploy sitting on top of it and the approved models underneath. A vertical stack, so it reads as
// a different idea from the horizontal Connect / Equip / Run flow in the hero.
//
// No model provider is named. Naming one would be a competitive statement, and the point here is
// that the layer does not depend on which one you picked.
const agents = [
  { mark: 'F', team: 'Finance', job: 'Monthly reporting', state: 'In use' },
  { mark: 'L', team: 'Legal', job: 'Contract review', state: 'In use' },
  { mark: 'O', team: 'Operations', job: 'Weekly ops pack', state: 'In review' },
] as const;

const layer = ['Company knowledge', 'Access rules', 'Human review', 'Usage figures'];
---

<figure class="agent-layer" data-reveal aria-labelledby="agent-layer-caption">
  <div class="product-frame">
    <div class="product-frame-bar">
      <div>
        <span class="product-mark" aria-hidden="true">Z</span>
        <span>Enterprise AI layer</span>
      </div>
      <span class="product-frame-status">Deployed across teams</span>
    </div>

    <section class="layer-agents" aria-labelledby="layer-agents-title">
      <p class="product-label" id="layer-agents-title">Agents teams run</p>
      <ul>
        {
          agents.map((agent) => (
            <li>
              <span class="layer-agent-mark" aria-hidden="true">
                {agent.mark}
              </span>
              <span class="layer-agent-copy">
                <strong>{agent.team}</strong>
                <small>{agent.job}</small>
              </span>
              <span class="layer-agent-state" data-state={agent.state}>
                {agent.state}
              </span>
            </li>
          ))
        }
        <li class="layer-agent-add">
          <span aria-hidden="true">+</span>
          Add an agent
        </li>
      </ul>
    </section>

    <section class="layer-governed" aria-labelledby="layer-governed-title">
      <p class="product-label" id="layer-governed-title">One governed layer</p>
      <ul>
        {layer.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="layer-models" aria-labelledby="layer-models-title">
      <p class="product-label" id="layer-models-title">Approved models</p>
      <p>Set by IT, and switchable without touching anything above.</p>
    </section>
  </div>
  <figcaption id="agent-layer-caption">
    Every team's agent sits on the same layer, so one set of rules covers all of them and one set of
    figures counts all of them.
  </figcaption>
</figure>
