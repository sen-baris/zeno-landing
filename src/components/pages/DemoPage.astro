---
import type { Locale } from '../../lib/i18n/locales';
import { createPageLocale } from '../../lib/i18n/page-copy';

const { locale } = Astro.props;
const { text: t } = createPageLocale(locale);
import DemoForm from '../islands/DemoForm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { claimRegistry } from '../../lib/claims/registry';
import { createPageClaimResolver } from '../../lib/i18n/de-claims';
const resolveApprovedClaims = createPageClaimResolver(locale);
import { createLocalizedSeo } from '../../lib/i18n/seo';

const preparationClaim = resolveApprovedClaims(
  claimRegistry,
  ['demo-meeting-preparation'],
  'demo.hero',
)[0]!;
const privacyAcknowledgementClaim = resolveApprovedClaims(
  claimRegistry,
  ['demo-response-data-use'],
  'demo.form',
)[0]!;
const seo = createLocalizedSeo({ kind: 'static', key: 'demo' }, locale);
interface Props {
  locale: Locale;
}
---

<BaseLayout
  title={t('Book a demo | Zeno')}
  description={t('Bring one enterprise workflow and request a prepared conversation with Zeno.')}
  seo={seo}
  pageClass="demo-page"
>
  <section class="demo-conversion section-rule" aria-labelledby="demo-page-title">
    <div class="shell demo-conversion-grid">
      <header class="demo-conversion-copy">
        <p class="eyebrow">{t('Book a demo')}</p>
        <h1 id="demo-page-title">{t('Bring us one workflow.')}</h1>
        <p>{t(preparationClaim.statement)}</p>
      </header>

      <DemoForm
        locale={locale}
        client:load
        privacyAcknowledgement={t(privacyAcknowledgementClaim.statement)}
      />
    </div>
  </section>

  <section class="demo-next section-rule" aria-labelledby="demo-next-title">
    <div class="shell demo-next-grid">
      <header>
        <p class="eyebrow">{t('What happens next')}</p>
        <h2 id="demo-next-title">{t('A prepared conversation.')}</h2>
      </header>
      <ol>
        <li><span>01</span>{t('We review the workflow and your starting context.')}</li>
        <li><span>02</span>{t('We prepare the key execution and governance questions.')}</li>
        <li><span>03</span>{t('We follow up with a relevant next step.')}</li>
      </ol>
    </div>
  </section>
</BaseLayout>
