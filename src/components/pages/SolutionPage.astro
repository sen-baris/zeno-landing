---
import type { Locale } from '../../lib/i18n/locales';
import { createPageLocale } from '../../lib/i18n/page-copy';

const { locale } = Astro.props;
const { text: t, path: withBase } = createPageLocale(locale);
import BaseLayout from '../../layouts/BaseLayout.astro';
import SolutionCustomerStory from '../SolutionCustomerStory.astro';
import SolutionAgents from '../SolutionAgents.astro';
import SolutionWorkspace from '../SolutionWorkspace.astro';
import { customerLogoAssets } from '../../lib/claims/customer-logo-assets';
import { claimRegistry } from '../../lib/claims/registry';
import { createPageClaimResolver } from '../../lib/i18n/de-claims';
const resolveApprovedClaims = createPageClaimResolver(locale);
import { customerStoryDrafts, customerVoiceDrafts } from '../../lib/content/customer-stories';
import { solutions } from '../../lib/content/solutions';
import { createLocalizedSeo } from '../../lib/i18n/seo';
import type { SolutionSlug } from '../../lib/i18n/routes';

const { solution } = Astro.props;
const solutionSurface = `solutions.${solution.slug}`;
const seo = createLocalizedSeo({ kind: 'solution', slug: solution.slug as SolutionSlug }, locale);

const [startingPointClaim, workspaceClaim, hostingClaim] = resolveApprovedClaims(
  claimRegistry,
  [solution.startingPointClaimId, solution.workspace.claimId, 'product-major-models-eu-hosting'],
  solutionSurface,
);
if (!startingPointClaim || !workspaceClaim || !hostingClaim) {
  throw new Error(`Product claims for /solutions/${solution.slug} are incomplete.`);
}
if (startingPointClaim.statement !== solution.journey[1]?.description) {
  throw new Error(`The starting-point narrative for /solutions/${solution.slug} is not approved.`);
}
if (workspaceClaim.statement !== solution.workspace.caption) {
  throw new Error(`The workspace caption for /solutions/${solution.slug} is not approved.`);
}

const logoByClaimId = new Map(customerLogoAssets.map((logo) => [logo.claimId, logo]));

const customerProof = (() => {
  const proofConfig = solution.customerProof;
  if (proofConfig.kind === 'story') {
    const story = customerStoryDrafts.find((candidate) => candidate.slug === proofConfig.storySlug);
    if (!story) throw new Error(`Customer story "${proofConfig.storySlug}" is missing.`);

    const [logoClaim, narrativeClaim, ...resultClaims] = resolveApprovedClaims(
      claimRegistry,
      [story.logoClaimId, story.narrativeClaimId, ...proofConfig.resultClaimIds],
      solutionSurface,
    );
    if (!logoClaim || !narrativeClaim) {
      throw new Error(`Customer proof for /solutions/${solution.slug} is incomplete.`);
    }
    if (narrativeClaim.statement !== `${story.title} ${story.summary}`) {
      throw new Error(`Customer narrative for /solutions/${solution.slug} is not approved.`);
    }

    const logo = logoByClaimId.get(logoClaim.id);
    if (!logo) throw new Error(`Approved customer logo asset "${logoClaim.id}" is missing.`);
    const resultByClaimId = new Map(
      story.qualifiedResults.map((result) => [result.claimId, result]),
    );
    const results = resultClaims.map((claim) => {
      const result = resultByClaimId.get(claim.id);
      if (!result) throw new Error(`Customer result "${claim.id}" is missing its display content.`);
      if (!claim.statement.includes(result.value) || !claim.statement.includes(result.label)) {
        throw new Error(`Customer result "${claim.id}" does not match its approved statement.`);
      }
      return result;
    });

    return {
      kind: 'story' as const,
      label: proofConfig.label,
      company: story.company,
      logo,
      title: story.title,
      summary: story.summary,
      href: `/customers/${story.slug}`,
      results,
    };
  }

  const [logoClaim, voiceClaim] = resolveApprovedClaims(
    claimRegistry,
    [proofConfig.logoClaimId, proofConfig.voiceId],
    solutionSurface,
  );
  if (!logoClaim || !voiceClaim) {
    throw new Error(`Customer quotation for /solutions/${solution.slug} is incomplete.`);
  }
  const logo = logoByClaimId.get(logoClaim.id);
  const voice = customerVoiceDrafts.find((candidate) => candidate.id === proofConfig.voiceId);
  if (!logo || !voice) throw new Error(`Frommer Legal customer proof is incomplete.`);

  return {
    kind: 'quote' as const,
    label: proofConfig.label,
    company: voice.company,
    logo,
    excerpt: voiceClaim.statement,
    attribution: voiceClaim.attribution,
  };
})();
interface Props {
  locale: Locale;
  solution: (typeof solutions)[number];
}
---

<BaseLayout
  title={t(`${solution.eyebrow} | Zeno`)}
  description={t(solution.metaDescription)}
  seo={seo}
>
  <section class="page-intro solution-intro section-rule">
    <div class="shell narrow-shell">
      <p class="eyebrow">{t(solution.eyebrow)}</p>
      <h1>{t(solution.headline)}</h1>
      <p>{t(solution.subhead)}</p>
      <div class="button-row solution-intro-actions">
        <a class="button button-primary" href={withBase('/demo')}>{t('Book a demo')}</a>
        <a class="text-link" href={withBase('/product')}>{t('See how the platform works →')}</a>
      </div>
    </div>
  </section>

  <section class="solution-product section-rule" aria-label={t(`${solution.eyebrow} product flow`)}>
    <div class="shell">
      <SolutionWorkspace
        locale={locale}
        journey={solution.journey}
        workspace={solution.workspace}
        startingPointStatement={startingPointClaim.statement}
        hostingStatement={hostingClaim.statement}
      />
    </div>
  </section>

  <SolutionCustomerStory locale={locale} proof={customerProof} />

  <section class="solution-work section-rule" aria-labelledby="solution-work-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">{t('The work')}</p>
          <h2 id="solution-work-title">{t(solution.workTitle)}</h2>
        </div>
        <p>{t(solution.workBody)}</p>
      </header>
      <SolutionAgents locale={locale} solution={solution} />
    </div>
  </section>

  <section class="solution-walls section-rule" aria-labelledby="solution-walls-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">{t('Governed workspace')}</p>
          <h2 id="solution-walls-title">{t(solution.wallsTitle)}</h2>
        </div>
        <p>{t(solution.wallsBody)}</p>
      </header>
      <div class="solution-control-panel" data-reveal>
        <header>
          <div>
            <p class="product-label">{t('Governed workspace')}</p>
            <p>{t('Controls stay with the work.')}</p>
          </div>
        </header>
        <dl>
          {
            solution.controls.map((control) => (
              <div>
                <dt>{t(control.label)}</dt>
                <dd>{t(control.value)}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="solution-questions section-rule" aria-labelledby="solution-questions-title">
    <div class="shell">
      <header class="section-heading">
        <p class="eyebrow">{t('Before you ask')}</p>
        <h2 id="solution-questions-title">{t(solution.questionsTitle)}</h2>
      </header>
      <dl class="solution-question-list">
        {
          solution.questions.map((entry) => (
            <div data-reveal>
              <dt>{t(entry.question)}</dt>
              <dd>{t(entry.answer)}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="conversion" aria-labelledby="solution-cta-title">
    <div class="shell conversion-grid">
      <div>
        <p class="eyebrow">{t('One job, then the next')}</p>
        <h2 id="solution-cta-title">{t(solution.closing)}</h2>
      </div>
      <div>
        <p>
          {
            t(
              "Bring one recurring document. We will show the agent's setup, its company context and the person who reviews the result.",
            )
          }
        </p>
        <div class="button-row">
          <a class="button button-paper" href={withBase('/demo')}>{t('Book a demo')}</a>
          <a class="button button-inverse" href={withBase('/pricing')}>{t('Assess AI readiness')}</a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
