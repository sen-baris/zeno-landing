---
import type { Locale } from '../../lib/i18n/locales';
import { createPageLocale } from '../../lib/i18n/page-copy';

const { locale } = Astro.props;
const { text: t, path: withBase } = createPageLocale(locale);
import BaseLayout from '../../layouts/BaseLayout.astro';
import { solutions } from '../../lib/content/solutions';
import { createLocalizedSeo } from '../../lib/i18n/seo';

const seo = createLocalizedSeo({ kind: 'static', key: 'solutions' }, locale);
interface Props {
  locale: Locale;
}
---

<BaseLayout
  title={t('Solutions | Zeno')}
  description={t(
    'Explore Zeno for manufacturing, management consulting, M&A advisory, private equity and legal. Each industry uses the same governed workspace with agents shaped for its work.',
  )}
  seo={seo}
>
  <section class="page-intro section-rule">
    <div class="shell narrow-shell">
      <p class="eyebrow">{t('Solutions')}</p>
      <h1>{t('The same workspace. Your work.')}</h1>
      <p>
        {
          t(
            'One governed workspace. Agents work from your company context and prepare documents your teams already own.',
          )
        }
      </p>
    </div>
  </section>

  <section class="solution-index section-rule" aria-labelledby="solution-index-title">
    <div class="shell narrow-shell">
      <h2 id="solution-index-title" class="visually-hidden">{t('Industries')}</h2>
      <ul class="solution-index-list">
        {
          solutions.map((solution, index) => (
            <li data-reveal>
              <a href={withBase(`/solutions/${solution.slug}`)}>
                <span class="item-number">{t(String(index + 1).padStart(2, '0'))}</span>
                <span class="solution-index-copy">
                  <b>{t(solution.navLabel)}</b>
                  <small>{t(solution.summary)}</small>
                </span>
                <span class="solution-index-go" aria-hidden="true">
                  {' '}
                  {t('→')}{' '}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="conversion" aria-labelledby="solutions-cta-title">
    <div class="shell conversion-grid">
      <div>
        <p class="eyebrow">{t('Not on the list?')}</p>
        <h2 id="solutions-cta-title">{t('The workspace does not care what the document is.')}</h2>
      </div>
      <div>
        <p>
          {
            t(
              'These are the industries we know best. The same governed workspace supports other document-heavy teams.',
            )
          }
        </p>
        <div class="button-row">
          <a class="button button-paper" href={withBase('/demo')}>{t('Book a demo')}</a>
          <a class="button button-inverse" href={withBase('/product')}>{t('See the product')}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
