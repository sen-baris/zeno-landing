---
import Glyph from './Glyph.astro';
import type { GlyphName } from './Glyph.astro';

interface Props {
  kind: 'workspace' | 'access' | 'adoption';
}

const { kind } = Astro.props;

// Everyday work, in the three shapes the card beside this one names.
const work = [
  { glyph: 'ask', label: 'Ask a question' },
  { glyph: 'draft', label: 'Draft a document' },
  { glyph: 'number', label: 'Check a number' },
] as const satisfies readonly { glyph: GlyphName; label: string }[];

// One agent, shared out with the access each team is given.
const shares = [
  { glyph: 'finance', team: 'Finance', access: 'Owner', level: 'own' },
  { glyph: 'legal', team: 'Legal', access: 'Can run', level: 'run' },
  { glyph: 'operations', team: 'Operations', access: 'Can view', level: 'view' },
] as const satisfies readonly { glyph: GlyphName; team: string; access: string; level: string }[];

// Weekly active users over twelve weeks. The same scenario the adoption panel on /product plots,
// reused rather than invented again so the site tells one story.
const weeks = [21, 26, 32, 38, 44, 51, 58, 64];
const peak = Math.max(...weeks);

const heads = {
  workspace: 'Everyday work',
  access: 'Monthly report agent',
  adoption: 'Weekly active',
} as const;

const feet = {
  workspace: 'Your company information',
  access: 'Access set by IT',
  adoption: '',
} as const;
---

{
  /*
  A small illustration of the sentence directly above it. All three are the same panel — a header
  band, a body, and a footer band, at one fixed height — so the row reads as three of one thing
  rather than three loose sketches.

  Hidden from assistive technology: the card says all of this in words, so reading it twice adds
  nothing, and it keeps an illustrative figure out of the screen-reader output.
*/
}
<div class="benefit-visual" data-visual={kind} aria-hidden="true">
  <p class="bv-head">{heads[kind]}</p>

  <div class="bv-body">
    {
      kind === 'workspace' && (
        <ul class="bv-rows">
          {work.map((item) => (
            <li>
              <span class="bv-mark">
                <Glyph name={item.glyph} />
              </span>
              {item.label}
            </li>
          ))}
        </ul>
      )
    }

    {
      kind === 'access' && (
        <ul class="bv-rows">
          {shares.map((share) => (
            <li>
              <span class="bv-mark">
                <Glyph name={share.glyph} />
              </span>
              {share.team}
              <span class="bv-access" data-level={share.level}>
                {share.access}
              </span>
            </li>
          ))}
        </ul>
      )
    }

    {
      kind === 'adoption' && (
        <>
          <p class="bv-figure">
            <span data-figure="64%">64%</span>
            <small>&uarr; from 21%</small>
          </p>
          <div class="bv-plot">
            {weeks.map((week) => (
              <span class="bv-col" style={`--column-height: ${Math.round((week / peak) * 100)}%`}>
                <i />
              </span>
            ))}
          </div>
        </>
      )
    }
  </div>

  {
    kind === 'adoption' ? (
      <p class="bv-foot bv-axis">
        <span>Week 1</span>
        <span>Week 12</span>
      </p>
    ) : (
      <p class="bv-foot">{feet[kind]}</p>
    )
  }
</div>
