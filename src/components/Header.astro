---
import { appLoginClaimId, claimRegistry } from '../lib/claims/registry';
import { resolveApprovedClaims } from '../lib/claims/public-claims';
import { solutions } from '../lib/content/solutions';
import type { Locale } from '../lib/i18n/locales';
import { getLocalizedPath, type SolutionSlug, type StaticRouteKey } from '../lib/i18n/routes';
import { sharedUiCopy, solutionNavigationLabels } from '../lib/i18n/ui';
import { withBase } from '../lib/routing/base-path';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = sharedUiCopy[locale].header;
const route = (key: StaticRouteKey) => {
  const path = getLocalizedPath({ kind: 'static', key }, locale);
  if (!path) throw new Error(`Navigation route "${key}" is unavailable for "${locale}".`);
  return withBase(path);
};
const solutionRoute = (slug: string) => {
  const path = getLocalizedPath({ kind: 'solution', slug: slug as SolutionSlug }, locale);
  if (!path) throw new Error(`Solution route "${slug}" is unavailable for "${locale}".`);
  return withBase(path);
};

const appLoginClaim = resolveApprovedClaims(
  claimRegistry,
  [appLoginClaimId],
  'navigation.sign-in',
)[0]!;
if (!appLoginClaim.public_url) throw new Error('Approved sign-in claim requires a public URL.');
const appLoginUrl = appLoginClaim.public_url;
---

<header class="site-header">
  <div class="shell header-grid">
    <a class="wordmark" href={route('home')} aria-label={copy.homeLabel}>Zeno</a>
    <nav class="desktop-nav" aria-label={copy.primaryNavigationLabel}>
      <a href={route('product')}>{copy.product}</a>
      {
        /*
        A details element rather than a scripted menu: it opens on click and on Enter and announces
        itself as expandable with no JavaScript at all. What it does not do natively is close again
        when attention moves elsewhere, so the script below adds Escape, outside click and focus
        leaving, and opens it on hover where there is a pointer that can hover. Without any of it
        the menu still opens and every link still works.
      */
      }
      <details class="nav-menu">
        <summary><span>{copy.solutions}</span></summary>
        <div class="nav-menu-panel">
          <p class="product-label">{copy.byIndustry}</p>
          <ul>
            {
              solutions.map((solution) => (
                <li>
                  <a href={solutionRoute(solution.slug)}>
                    {solutionNavigationLabels[locale][solution.slug]}
                  </a>
                </li>
              ))
            }
            <li class="nav-menu-all">
              <a href={route('solutions')}>{copy.allIndustries}</a>
            </li>
          </ul>
        </div>
      </details>
      <a href={route('security')}>{copy.security}</a>
      <a class="nav-business-case-cta" href={route('pricing')}>
        <span>{copy.businessCase}</span>
        <span class="nav-action-arrow" aria-hidden="true">→</span>
      </a>
    </nav>
    <div class="header-actions">
      <a class="button button-small button-secondary" href={appLoginUrl} data-sign-in-link
        >{locale === 'en' ? appLoginClaim.statement : copy.signIn}</a
      >
      <a class="button button-small button-primary" href={route('demo')}>{copy.bookDemo}</a>
    </div>
    <details class="mobile-menu">
      <summary aria-label={copy.menuOpenLabel}>{copy.menuLabel}</summary>
      <nav aria-label={copy.mobileNavigationLabel}>
        <a href={route('product')}>{copy.product}</a>
        <a href={route('solutions')}>{copy.solutions}</a>
        {
          solutions.map((solution) => (
            <a class="mobile-menu-nested" href={solutionRoute(solution.slug)}>
              {solutionNavigationLabels[locale][solution.slug]}
            </a>
          ))
        }
        <a href={route('security')}>{copy.security}</a>
        <a class="mobile-nav-business-case" href={route('pricing')}>
          <span>{copy.businessCase}</span>
          <span class="nav-action-arrow" aria-hidden="true">→</span>
        </a>
        <a href={appLoginUrl} data-sign-in-link>
          {locale === 'en' ? appLoginClaim.statement : copy.signIn}
        </a>
        <a href={route('demo')}>{copy.bookDemo}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
  });

  // Opening is native. Closing again when attention moves elsewhere is not, so it is added here:
  // Escape, a click outside, and focus leaving.
  const menu = document.querySelector<HTMLDetailsElement>('.nav-menu');
  if (menu) {
    const close = () => menu.removeAttribute('open');
    for (const link of menu.querySelectorAll('a')) link.addEventListener('click', close);

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      close();
      // Escape should leave the reader where they were, not at the top of the document.
      menu.querySelector('summary')?.focus();
    });

    document.addEventListener('click', (event) => {
      if (!menu.open || menu.contains(event.target as Node)) return;
      close();
    });
    document.addEventListener('focusin', (event) => {
      if (!menu.open || menu.contains(event.target as Node)) return;
      close();
    });

    // On a device with a pointer that can hover, the menu follows the pointer. A touch screen
    // reports no hover and keeps the native tap-to-open, which is the only thing that works there.
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    const panel = menu.querySelector('.nav-menu-panel');
    let closeTimer = 0;

    menu.addEventListener('pointerenter', () => {
      if (!canHover.matches) return;
      window.clearTimeout(closeTimer);
      menu.open = true;
    });

    menu.addEventListener('pointerleave', () => {
      if (!canHover.matches) return;
      // A short grace period covers a diagonal path off the trigger. Closing under a reader who is
      // tabbing through the panel would throw their focus to the top of the document, so the panel
      // stays open while it holds focus. Focus resting on the trigger does not count: that is where
      // a click leaves it, and a pointer moving away should still close what it opened.
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        if (!panel?.contains(document.activeElement)) close();
      }, 120);
    });

    // WebKit does not activate a summary with Enter, only with Space, so Safari readers cannot
    // open this from the keyboard at all. Enter is handled here for every engine, and the default
    // is prevented so the ones that do act on it are not toggling twice.
    menu.querySelector('summary')?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      menu.open = !menu.open;
    });

    menu.querySelector('summary')?.addEventListener('click', (event) => {
      // Arriving at the trigger already opened it, so the native toggle would close it on the way
      // in. Only a click on an open menu is suppressed: once it is closed, by Escape or otherwise,
      // clicking has to open it again even though the pointer never left.
      if (!canHover.matches || !menu.open) return;
      event.preventDefault();
    });
  }
</script>
