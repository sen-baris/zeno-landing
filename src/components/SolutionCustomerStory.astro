---
import type { Locale } from '../lib/i18n/locales';
import { createPageLocale } from '../lib/i18n/page-copy';

const { locale } = Astro.props;
const { text: t, path: withBase } = createPageLocale(locale);
import type { CustomerLogoAsset } from '../lib/claims/customer-logo-assets';
import type { CustomerResultDraft } from '../lib/content/customer-stories';

interface StoryProof {
  kind: 'story';
  label: string;
  company: string;
  logo: CustomerLogoAsset;
  title: string;
  summary: string;
  href: string;
  results: readonly CustomerResultDraft[];
}

interface QuoteProof {
  kind: 'quote';
  label: string;
  company: string;
  logo: CustomerLogoAsset;
  excerpt: string;
  attribution: string;
}

interface Props {
  locale: Locale;
  proof: StoryProof | QuoteProof;
}

const { proof } = Astro.props;
---

<section class="solution-customer section-rule" aria-labelledby="solution-customer-title">
  <div class="shell">
    <article class="solution-customer-card" data-proof-kind={proof.kind}>
      <header class="solution-customer-heading">
        <div>
          <p class="eyebrow">{t(proof.label)}</p>
          <img
            src={withBase(proof.logo.src)}
            alt={t(proof.logo.name)}
            width="400"
            height="400"
            loading="lazy"
            decoding="async"
          />
        </div>
        {
          proof.kind === 'story' ? (
            <div>
              <h2 id="solution-customer-title">{t(proof.title)}</h2>
              <p>{t(proof.summary)}</p>
              <a class="text-link" href={withBase(proof.href)}>
                {' '}
                {t('Read customer story')} <span aria-hidden="true">→</span>
              </a>
            </div>
          ) : (
            <figure lang="en">
              <blockquote>
                <p id="solution-customer-title">“{proof.excerpt}”</p>
              </blockquote>
              <figcaption>{proof.attribution}</figcaption>
            </figure>
          )
        }
      </header>

      {
        proof.kind === 'story' && (
          <ul
            class="solution-customer-results"
            data-result-count={proof.results.length}
            aria-label={t(`${proof.company} results`)}
          >
            {proof.results.map((result) => (
              <li>
                <strong>{t(result.value)}</strong>
                <span>{t(result.label)}</span>
                <small>{t(result.qualifier)}</small>
              </li>
            ))}
          </ul>
        )
      }
    </article>
  </div>
</section>
