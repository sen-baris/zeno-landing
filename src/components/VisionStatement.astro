---
import { Image } from 'astro:assets';
import founders from '../assets/team/founders.jpg';
import teamEvening from '../assets/team/team-evening.jpg';
import teamDesk from '../assets/team/team-desk.jpg';
import teamSummit from '../assets/team/team-summit.jpg';
import teamOffsite from '../assets/team/team-offsite.jpg';

// The statement is split into sentences at authoring time, not into words. Word spans bloat the DOM
// and fight the global text-wrap: balance and overflow-wrap: anywhere, for an effect nobody reads
// word by word anyway.
const lines = [
  'We are not handing you a tool and wishing you luck.',
  'The rollouts that work have someone from our side inside them, finding the work worth automating, building the first agent with the team that will use it, and staying once it runs.',
  'That part does not scale by writing more software. We do it anyway.',
  'Three steps, and you are in all of them.',
];

// The three steps the sentences above describe. The promise on its own is a claim; a reader who
// believes it still has no idea what the first month looks like, so each step says who does what.
//
// The last line of the statement used to carry the month-six measure. Step three carries it now:
// on one screen it only needed saying once.
const steps = [
  {
    number: '01',
    name: 'The workshop',
    body: 'We sit with the team and find the work worth automating.',
    ours: 'We run it and bring what we have seen work elsewhere.',
    yours: 'You leave having chosen the first agent, not holding a strategy deck.',
  },
  {
    number: '02',
    name: 'The first agent',
    body: 'We build it with the people who will use it, on your systems and your documents.',
    ours: 'We build, connect the sources, and set what it may read.',
    yours: 'Your team reviews what it produces until they would put their name to it.',
  },
  {
    number: '03',
    name: 'After it is live',
    body: 'We stay for the next one, and for the ones that stall.',
    ours: 'We keep building, and we watch where adoption drops.',
    yours:
      'You hold us to the only measure that counts: whether your teams are still using the first one in month six.',
  },
];
---

<section class="vision section-rule" id="vision" aria-labelledby="vision-title">
  <div class="shell vision-grid">
    <div class="vision-media vision-media-lead">
      <figure data-reveal>
        <Image src={founders} alt="The two co-founders in the office." />
      </figure>
      <figure data-reveal>
        <Image src={teamDesk} alt="Three of the team working late around a shared desk." />
      </figure>
      <figure data-reveal>
        <Image src={teamOffsite} alt="Two colleagues holding caricatures drawn at a conference." />
      </figure>
    </div>

    <div class="vision-copy">
      <p class="eyebrow">Who you would be working with</p>
      <h2 id="vision-title">Software is the easy half.</h2>
      <div class="vision-lines">
        {lines.map((line) => <p class="vision-line">{line}</p>)}
      </div>
    </div>

    <div class="vision-media vision-media-trail">
      <figure data-reveal>
        <Image src={teamEvening} alt="Part of the team together at the end of a working day." />
      </figure>
      <figure data-reveal>
        <Image src={teamSummit} alt="A colleague at the company stand during an AI summit." />
      </figure>
    </div>
  </div>

  {
    /*
    Below the grid rather than inside it: the statement sits in the middle column of three, which is
    too narrow to hold a row of steps without setting them at a size nothing else on the page uses.

    Plain markup with one reveal. The scroll script above only touches .vision-line, so these read
    the same with no JavaScript, under reduced motion, and on a page where the script failed.
  */
  }
  <ol class="shell vision-steps" data-reveal aria-label="How a rollout goes">
    {
      steps.map((step) => (
        <li>
          <p class="vision-step-head">
            <span class="item-number">{step.number}</span>
            <b>{step.name}</b>
          </p>
          <p class="vision-step-body">{step.body}</p>
          <p class="vision-step-part">
            <span>From us</span>
            {step.ours}
          </p>
          <p class="vision-step-part">
            <span>From you</span>
            {step.yours}
          </p>
        </li>
      ))
    }
  </ol>
</section>

<script>
  // Lines darken as the reader reaches them. Dimming is done with colour, never opacity: --muted
  // still passes AA against the page, whereas a faded line would fail contrast and would also trip
  // the assertion that nothing inside a revealed container sits below full opacity.
  //
  // Driven by geometry on scroll rather than IntersectionObserver. An observer only reports
  // transitions, so a single jump — an anchor link, a scrollbar drag, a keyboard Page Down — can
  // carry a line from below the trigger to above the viewport without ever intersecting, and it
  // would stay dimmed behind the reader forever. Reading four rectangles on a throttled scroll is
  // both simpler and correct.
  if (document.documentElement.getAttribute('data-motion') === 'on') {
    const lines = Array.from(document.querySelectorAll<HTMLElement>('.vision-line'));

    if (lines.length > 0) {
      let queued = false;

      const markPassed = () => {
        queued = false;
        const trigger = window.innerHeight * 0.72;
        let remaining = false;
        for (const line of lines) {
          if (line.getBoundingClientRect().top < trigger) {
            line.setAttribute('data-read', '');
          } else {
            remaining = true;
          }
        }
        // Every line has been read, so there is nothing left to watch for.
        if (!remaining) stop();
      };

      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(markPassed);
      };

      function stop(): void {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      markPassed();

      window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (event) => {
        if (!event.matches) return;
        stop();
        for (const line of lines) line.setAttribute('data-read', '');
      });
    }
  }
</script>
