---
interface Props {
  layers: readonly { name: string }[];
  /** Index of the layer currently being read. Omitted on a static stack, where nothing leads. */
  activeIndex?: number | undefined;
}

const { layers, activeIndex } = Astro.props;

function stateOf(index: number): string | undefined {
  if (activeIndex === undefined) return undefined;
  if (index === activeIndex) return 'current';
  return index < activeIndex ? 'past' : 'future';
}
---

{
  /*
  An exploded isometric stack built from plain elements rather than a render: one rotation on the
  scene, and each plate pushed along the rotated Z axis so it floats above the one below it. Layer
  one is the foundation at the bottom; the last layer covers everything under it.

  THE PLATES MUST STAY DIRECT CHILDREN OF THE SCENE. Measured in Chromium, Firefox and WebKit: any
  element between them — even a plain wrapper with no styles at all — flattens the stack to nothing,
  and `getComputedStyle` still reports `preserve-3d`, so the failure is invisible to CSSOM and to a
  test. Ancestors of the scene are harmless, including the reveal layer's `opacity: 0`.

  Each plate names itself. The label counter-rotates out of the plate's plane so it faces the reader
  upright rather than being sheared along with it, and sits off the plate's left corner, which the
  projection puts at the leftmost point of the rhombus with clear space beside it.

  Decorative throughout: the same names are listed beside the stack, in order, which is the whole of
  it on a narrow screen. So the figure stays out of the accessibility tree.
*/
}
<div class="layer-scene" style={`--count: ${layers.length}`} aria-hidden="true">
  {
    layers.map((layer, index) => (
      <div class="layer-plate" style={`--depth: ${index}`} data-state={stateOf(index)}>
        <span class="layer-plate-label">
          <b>{String(index + 1).padStart(2, '0')}</b>
          {layer.name}
        </span>
      </div>
    ))
  }
</div>
