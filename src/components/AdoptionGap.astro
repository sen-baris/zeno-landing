---
// The adoption view, showing a rollout that took hold. Every figure here is a scenario, not a
// measured Zeno result, which is why the frame is labelled as one and the caption says so plainly.
// It carries no claim record for the same reason the "Today" column of the contrast does not.
//
// One series, so one colour for every column and no legend: the panel heading names what is
// plotted. Column fill is --action and the deltas are --evidence; that pair was checked for
// colour-vision separation (ΔE 19.0 deutan, 19.5 normal) and contrast against the panel surface.
// The deltas carry an arrow and words, so the state never depends on colour alone.
const stats = [
  { label: 'Weekly active', value: '64%', direction: 'up', delta: 'from 21% in month one' },
  { label: 'Messages per active user', value: '31', direction: 'up', delta: 'from 9 at launch' },
  { label: 'Teams using it twice', value: '11 of 14', direction: 'up', delta: 'up from 3' },
  { label: 'Seats idle 30 days', value: '9%', direction: 'down', delta: 'down from 46%' },
] as const;

// Weekly active users, week 1 to 12: a slow start, then it holds and keeps climbing.
const weeks = [21, 27, 33, 36, 40, 45, 48, 52, 55, 58, 61, 64];
const peak = Math.max(...weeks);
// Label the first and last column only. A number on every column goes unread.
const labelled = new Set([0, weeks.length - 1]);
---

<figure class="adoption-gap" data-reveal aria-labelledby="adoption-gap-caption">
  <div class="product-frame">
    <div class="product-frame-bar">
      <div>
        <span class="product-mark" aria-hidden="true">Z</span>
        <span>Adoption</span>
      </div>
      <span class="product-frame-status gap-status">A rollout that took hold</span>
    </div>

    <ul class="gap-stats">
      {
        stats.map((stat) => (
          <li>
            <p class="product-label">{stat.label}</p>
            <p class="gap-value">{stat.value}</p>
            <p class="gap-delta" data-direction={stat.direction}>
              <span aria-hidden="true">{stat.direction === 'down' ? '↓' : '↑'}</span>
              {stat.delta}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="gap-chart">
      <div class="gap-chart-head">
        <p class="product-label">Weekly active users</p>
        <span>Week 1 to week 12</span>
      </div>
      {/* The figures are already stated in the tiles above, so the plot itself is decorative. */}
      <div class="gap-plot" aria-hidden="true">
        {
          weeks.map((week, index) => (
            <div class="gap-col" style={`--column-height: ${Math.round((week / peak) * 100)}%`}>
              {labelled.has(index) && <span class="gap-col-label">{week}%</span>}
              <i />
            </div>
          ))
        }
      </div>
      <div class="gap-axis" aria-hidden="true">
        <span>Week 1</span>
        <span>Week 12</span>
      </div>
    </div>
  </div>
  <figcaption id="adoption-gap-caption">
    The figures administrators can watch week to week: who is active, who came back, and how many
    seats are sitting idle.
  </figcaption>
</figure>
