---
import LayerStack from './LayerStack.astro';
import { withBase } from '../lib/routing/base-path';

interface Props {
  layers: readonly { name: string; body: string }[];
}

const { layers } = Astro.props;
---

{
  /*
  The platform assembling itself. The reader never leaves this block: the pin holds the diagram and
  its key still while the container's own padding supplies the scroll, and each step drops the next
  layer into place. Any row can be clicked to jump straight to its layer.

  Nothing below is applied unless the controller has confirmed support and set data-sequence="on".
  Without JavaScript, with reduced motion, on a narrow screen, or in a window too short to hold the
  pin, this is a finished stack beside a list of six layers, each named and said in one line — which
  is the same rendering three existing tests already exercise on every run.
*/
}
<div class="platform-stack" data-sequence="off" style={`--steps: ${layers.length}`}>
  <div class="platform-stack-pin">
    <LayerStack layers={layers} />
    <div class="platform-stack-key">
      <p class="product-label">Built from the models up</p>
      <ol class="layer-legend">
        {
          layers.map((layer, index) => (
            <li>
              <div class="layer-legend-row">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <span>
                  <b>{layer.name}</b>
                  <small>{layer.body}</small>
                </span>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="platform-stack-more">
        <a class="text-link" href={withBase('/product')}>See how the platform works &rarr;</a>
      </p>
    </div>
  </div>
</div>

<script>
  const stack = document.querySelector<HTMLElement>('.platform-stack');
  const pin = stack?.querySelector<HTMLElement>('.platform-stack-pin') ?? null;
  const motionOn = document.documentElement.getAttribute('data-motion') === 'on';

  // Its own flag rather than data-motion-ready: the runtime's two-second failsafe must never be
  // able to pull position: sticky out from under someone mid-scroll.
  if (
    stack &&
    pin &&
    motionOn &&
    typeof CSS !== 'undefined' &&
    CSS.supports('position', 'sticky') &&
    window.matchMedia('(min-width: 900px)').matches
  ) {
    const plates = Array.from(stack.querySelectorAll<HTMLElement>('.layer-plate'));
    const rows = Array.from(stack.querySelectorAll<HTMLElement>('.layer-legend-row'));
    const steps = rows.length;

    // Has to agree with the sticky offset in the stylesheet, because the scroll maths below is
    // measured from the line the pin comes to rest on.
    const stickyTop = () => Math.min(140, Math.max(88, window.innerHeight * 0.12));

    // Holding something taller than the window would leave part of it permanently off screen, so
    // a short viewport declines the whole behaviour rather than half of it.
    const fits = () => window.innerHeight > pin.offsetHeight + stickyTop() + 40;

    if (steps > 0 && plates.length === steps && fits()) {
      stack.dataset.sequence = 'on';
      let queued = false;
      let shown = -1;

      // The distance the reader travels while the pin is held.
      const span = () => stack.offsetHeight - pin.offsetHeight;

      // Computed from geometry rather than from IntersectionObserver events. The state has to be
      // right after a jump in either direction — a row click, a scrollbar drag, Page Up — and an
      // observer only reports the transitions it happens to witness.
      const update = () => {
        queued = false;
        const total = span();
        const travelled = stickyTop() - stack.getBoundingClientRect().top;
        const scrolled = Math.min(Math.max(travelled, 0), total);
        const active = total > 0 ? Math.min(steps - 1, Math.floor((scrolled / total) * steps)) : 0;
        if (active === shown) return;
        shown = active;

        for (const [index, plate] of plates.entries()) {
          plate.dataset.state =
            index < active ? 'placed' : index === active ? 'current' : 'pending';
        }
        for (const [index, row] of rows.entries()) {
          row.dataset.state = index < active ? 'placed' : index === active ? 'current' : 'pending';
          if (index === active) row.setAttribute('aria-current', 'step');
          else row.removeAttribute('aria-current');
        }
      };

      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      };

      // Lands in the middle of the step's share of the track, so the target state is never a
      // rounding error away from the next one. html carries scroll-behavior: smooth, which reduced
      // motion already overrides, so this needs no behaviour of its own.
      const goTo = (index: number) => {
        const top =
          window.scrollY +
          stack.getBoundingClientRect().top -
          stickyTop() +
          ((index + 0.5) / steps) * span();
        window.scrollTo({ top });
      };

      // Upgraded here rather than shipped in the markup: a row is only worth clicking once this
      // controller exists to answer, and the role goes on the row instead of its li so the ordered
      // list keeps its listitems.
      for (const [index, row] of rows.entries()) {
        row.setAttribute('role', 'button');
        row.setAttribute('tabindex', '0');
        row.addEventListener('click', () => goTo(index));
        row.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          goTo(index);
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();

      window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (event) => {
        if (!event.matches) return;
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        stack.dataset.sequence = 'off';
        for (const element of [...plates, ...rows]) delete element.dataset.state;
        for (const row of rows) {
          row.removeAttribute('role');
          row.removeAttribute('tabindex');
          row.removeAttribute('aria-current');
        }
      });
    }
  }
</script>
