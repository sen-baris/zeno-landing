---
interface Props {
  statement: string;
  caption: string;
}

const { statement, caption } = Astro.props;
---

<figure
  class="product-workspace chat-workspace"
  data-reveal
  aria-labelledby="chat-workspace-caption"
>
  <div class="product-frame">
    <div class="product-frame-bar">
      <div>
        <span class="product-mark" aria-hidden="true">Z</span>
        <span>Chat</span>
      </div>
      <span class="product-frame-status">Finance Agent</span>
    </div>

    <div class="chat-workspace-body">
      <aside class="chat-agent-summary" aria-labelledby="chat-agent-title">
        <div>
          <p class="product-label">Selected agent</p>
          <span class="chat-agent-mark" aria-hidden="true">F</span>
          <h3 id="chat-agent-title">Finance Agent</h3>
          <p>Monthly reporting</p>
        </div>
        <dl>
          <div>
            <dt>Knowledge</dt>
            <dd>Finance team</dd>
          </div>
          <div>
            <dt>Context</dt>
            <dd>3 connected sources</dd>
          </div>
        </dl>
      </aside>

      <section class="chat-thread" aria-labelledby="chat-thread-title">
        <div class="chat-thread-heading">
          <div>
            <p class="product-label">Conversation</p>
            <h3 id="chat-thread-title">Monthly finance review</h3>
          </div>
          <span>Company context on</span>
        </div>

        <ol class="chat-message-list">
          <li data-speaker="person">
            <span>You</span>
            <p>
              Prepare this month&apos;s finance review. Focus on the largest variances and the
              questions leadership should discuss.
            </p>
          </li>
          <li data-speaker="agent">
            <span>Finance Agent</span>
            <p>
              I prepared a first review from the selected company context. The three areas that need
              attention are ready for your review.
            </p>
            <div class="chat-result-card">
              <div>
                <span class="product-label">Draft</span>
                <strong>Monthly finance review</strong>
              </div>
              <ul>
                <li>Revenue overview</li>
                <li>Variance summary</li>
                <li>Questions for review</li>
              </ul>
            </div>
          </li>
        </ol>

        <div class="chat-context-strip" aria-label="Connected context">
          <span>Connected context</span>
          <ul>
            <li>Finance knowledge</li>
            <li>Reporting data</li>
            <li>Team guidance</li>
          </ul>
        </div>
      </section>
    </div>
  </div>
  <figcaption id="chat-workspace-caption" class="visually-hidden">
    {statement}{' '}{caption}
  </figcaption>
</figure>
