<figure class="product-workspace" data-reveal aria-labelledby="workspace-caption">
  <div class="product-frame">
    <div class="product-frame-bar">
      <div>
        <span class="product-mark" aria-hidden="true">Z</span>
        <span>Presentation Agent</span>
      </div>
      <span class="product-frame-status">Ready for review</span>
    </div>

    <div class="presentation-workspace">
      <section class="presentation-brief" aria-labelledby="brief-title">
        <p class="product-label">Brief</p>
        <h3 id="brief-title">Create the quarterly business review.</h3>
        <p>
          Prepare an on-brand leadership deck using the latest company knowledge and reporting data.
        </p>
        <dl>
          <div>
            <dt>Audience</dt>
            <dd>Leadership team</dd>
          </div>
          <div>
            <dt>Output</dt>
            <dd>8-slide presentation</dd>
          </div>
        </dl>
      </section>

      <section class="presentation-sources" aria-labelledby="sources-title">
        <p class="product-label" id="sources-title">Approved sources</p>
        <ul>
          <li><span>01</span>Company knowledge</li>
          <li><span>02</span>Brand template</li>
          <li><span>03</span>Reporting data</li>
