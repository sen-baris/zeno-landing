---
import DemoForm from '../components/islands/DemoForm';
import BaseLayout from '../layouts/BaseLayout.astro';
import { claimRegistry } from '../lib/claims/registry';
import { resolveApprovedClaims } from '../lib/claims/public-claims';

const preparationClaim = resolveApprovedClaims(
  claimRegistry,
  ['demo-meeting-preparation'],
  'demo.hero',
)[0]!;
const privacyAcknowledgementClaim = resolveApprovedClaims(
  claimRegistry,
  ['demo-response-data-use'],
  'demo.form',
)[0]!;
---

<BaseLayout
  title="Book a demo | Zeno"
  description="Bring one enterprise workflow and request a prepared conversation with Zeno."
  canonicalPath="/demo"
  pageClass="demo-page"
>
  <section class="demo-conversion section-rule" aria-labelledby="demo-page-title">
    <div class="shell demo-conversion-grid">
      <header class="demo-conversion-copy">
        <p class="eyebrow">Book a demo</p>
        <h1 id="demo-page-title">Bring us one workflow.</h1>
        <p>{preparationClaim.statement}</p>
      </header>

      <DemoForm client:load privacyAcknowledgement={privacyAcknowledgementClaim.statement} />
    </div>
  </section>

  <section class="demo-next section-rule" aria-labelledby="demo-next-title">
    <div class="shell demo-next-grid">
      <header>
        <p class="eyebrow">What happens next</p>
        <h2 id="demo-next-title">A prepared conversation.</h2>
      </header>
      <ol>
        <li><span>01</span>We review the workflow and your starting context.</li>
        <li><span>02</span>We prepare the key execution and governance questions.</li>
        <li><span>03</span>We follow up with a relevant next step.</li>
      </ol>
    </div>
  </section>
</BaseLayout>
