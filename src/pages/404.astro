---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/routing/base-path';
---

<BaseLayout
  title="Page not found | Zeno"
  description="The requested Zeno page could not be found."
  canonicalPath="/404"
>
  <section class="error-page section-rule">
    <div class="shell narrow-shell">
      <p class="eyebrow">Error / 404</p>
      <h1>This path is not in the ledger.</h1>
      <p>Return home or build a case for one workflow.</p>
      <div class="button-row">
        <a class="button button-ink" href={withBase('/')}>Go home</a>
        <a class="button button-ghost" href={withBase('/pricing')}>Assess AI readiness</a>
      </div>
    </div>
  </section>
</BaseLayout>
