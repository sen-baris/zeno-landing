---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createStandaloneSeo } from '../lib/i18n/seo';
import { withBase } from '../lib/routing/base-path';

const seo = createStandaloneSeo('en', '/500');
---

<BaseLayout
  title="Something went wrong | Zeno"
  description="The requested Zeno page failed to load."
  seo={seo}
  noIndex
>
  <section class="error-page section-rule">
    <div class="shell narrow-shell">
      <p class="eyebrow">Error / 500</p>
      <h1>This page did not load.</h1>
      <p>Return home and try again.</p>
      <a class="button button-ink" href={withBase('/')}>Go home</a>
    </div>
  </section>
</BaseLayout>
