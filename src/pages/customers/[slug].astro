---
import CustomerStoryPage from '../../components/pages/CustomerStoryPage.astro';
import {
  customerStoryDrafts,
  selectCustomerStoriesForMode,
  resolveCustomerProofMode,
} from '../../lib/content/customer-stories';
export function getStaticPaths() {
  return selectCustomerStoriesForMode(customerStoryDrafts, resolveCustomerProofMode()).map(
    (story) => ({ params: { slug: story.slug }, props: { story } }),
  );
}
---

<CustomerStoryPage locale="en" story={Astro.props.story} />
