---
import SolutionPage from '../../components/pages/SolutionPage.astro';
import { solutions } from '../../lib/content/solutions';
export function getStaticPaths() {
  return solutions.map((solution) => ({ params: { slug: solution.slug }, props: { solution } }));
}
---

<SolutionPage locale="en" solution={Astro.props.solution} />
