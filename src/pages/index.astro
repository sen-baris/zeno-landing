---
import BaseLayout from '../layouts/BaseLayout.astro';
import BusinessCase from '../components/BusinessCase.astro';
import CustomerLogoRail from '../components/CustomerLogoRail.astro';
import GovernedWorkspace from '../components/GovernedWorkspace.astro';
import AdoptionPartnership from '../components/AdoptionPartnership.astro';
import TrustCertifications from '../components/TrustCertifications.astro';
import VisionStatement from '../components/VisionStatement.astro';
import { businessCaseAssets } from '../lib/claims/business-case-assets';
import { certificationAssets } from '../lib/claims/certification-assets';
import { customerLogoAssets } from '../lib/claims/customer-logo-assets';
import {
  claimRegistry,
  homepageBusinessCaseClaimIds,
  homepageCertificationClaimIds,
  homepageCustomerLogoClaimIds,
  homepageDeploymentClaimIds,
  homepageProofClaimIds,
  homepageTestimonialClaimIds,
  trustCenterUrl,
} from '../lib/claims/registry';
import { resolveApprovedClaims } from '../lib/claims/public-claims';
import { withBase } from '../lib/routing/base-path';
import {
  adoptionPartnership,
  audiences,
  draftHomeCopy,
  operatingShift,
} from '../lib/content/site-content';

const approvedProof = resolveApprovedClaims(claimRegistry, homepageProofClaimIds, 'home.proof');
const approvedCertifications = resolveApprovedClaims(
  claimRegistry,
  homepageCertificationClaimIds,
  'home.trust',
);
// One deployment fact, resolved the same way as everything else on this surface, so it cannot be
// published without the record that approved it.
const approvedDeployment = resolveApprovedClaims(
  claimRegistry,
  homepageDeploymentClaimIds,
  'home.trust',
);

const approvedBusinessCase = resolveApprovedClaims(
  claimRegistry,
  homepageBusinessCaseClaimIds,
  'home.business-case',
);
const approvedQuotes = resolveApprovedClaims(
  claimRegistry,
  homepageTestimonialClaimIds,
  'home.testimonials',
);
const approvedCustomerLogoClaims = resolveApprovedClaims(
  claimRegistry,
  homepageCustomerLogoClaimIds,
  'home.customer-logos',
);
const customerLogoByClaimId = new Map(customerLogoAssets.map((logo) => [logo.claimId, logo]));
const approvedCustomerLogos = approvedCustomerLogoClaims.map((claim) => {
  const logo = customerLogoByClaimId.get(claim.id);
  if (!logo) throw new Error(`Approved customer logo asset "${claim.id}" is missing.`);
  return logo;
});
---

<BaseLayout title={draftHomeCopy.title} description={draftHomeCopy.description} canonicalPath="/">
  <section class="hero section-rule">
    <div class="shell hero-layout">
      <div class="hero-intro">
        <div>
          <h1>{draftHomeCopy.headline}</h1>
        </div>
        <div class="hero-message">
          <p class="hero-subhead">{draftHomeCopy.subhead}</p>
          <div class="hero-action" role="group" aria-label="Hero call to action">
            <a class="button button-primary" href={withBase('/demo')}>Book a demo</a>
          </div>
        </div>
      </div>
      <GovernedWorkspace />
    </div>
  </section>

  <CustomerLogoRail
    logos={approvedCustomerLogos}
    audiences={audiences}
    proof={approvedProof}
    quote={approvedQuotes[0]}
  />

  <section
    class="business-case section-rule"
    id="business-case"
    aria-labelledby="business-case-title"
  >
    <div class="shell">
      <header class="section-heading">
        <p class="eyebrow">Business case</p>
        <h2 id="business-case-title">What enterprises are seeing.</h2>
      </header>
      <BusinessCase results={approvedBusinessCase} assets={businessCaseAssets} />
    </div>
  </section>

  <section
    class="adoption-partnership section-rule"
    id="why"
    aria-labelledby="adoption-partnership-title"
  >
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">{adoptionPartnership.eyebrow}</p>
          <h2 id="adoption-partnership-title">{adoptionPartnership.title}</h2>
        </div>
        <p>{adoptionPartnership.intro}</p>
      </header>
      <AdoptionPartnership />
    </div>
  </section>

  <VisionStatement />

  <section class="operating-shift section-rule" id="shift" aria-labelledby="shift-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">Before and after</p>
          <h2 id="shift-title">The same quarter, two ways.</h2>
        </div>
        <p>
          No new team and no new process. The same work, somewhere you can actually see it happen.
        </p>
      </header>
      <div class="shift-compare" data-reveal>
        <section class="shift-column shift-today" aria-labelledby="shift-today-title">
          <h3 id="shift-today-title" class="product-label">Today</h3>
          <ul>
            {operatingShift.today.map((line) => <li>{line}</li>)}
          </ul>
        </section>
        <section class="shift-column shift-zeno" aria-labelledby="shift-zeno-title">
          <h3 id="shift-zeno-title" class="product-label">With Zeno</h3>
          <ul>
            {operatingShift.withZeno.map((line) => <li>{line}</li>)}
          </ul>
        </section>
      </div>
    </div>
  </section>

  <section class="adoption-trust section-rule" id="trust" aria-labelledby="trust-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">Trust and control</p>
          <h2 id="trust-title">Scale without giving up control.</h2>
        </div>
        <p>
          Who can see what, which models are allowed, and where a person has to sign off. Set once,
          visible to IT.
        </p>
      </header>
      {
        approvedDeployment.map((claim) => (
          <p class="trust-deployment">
            {claim.statement}
            {claim.attribution && <span>{claim.attribution}</span>}
          </p>
        ))
      }
      <TrustCertifications
        certifications={approvedCertifications}
        assets={certificationAssets}
        trustCenterUrl={trustCenterUrl}
      />
    </div>
  </section>

  <section class="conversion" aria-labelledby="conversion-title">
    <div class="shell conversion-grid">
      <div>
        <p class="eyebrow">Not ready for a demo?</p>
        <h2 id="conversion-title">Find where AI can become useful first.</h2>
      </div>
      <div>
        <p>
          Nine questions about one workflow. You get a score and a suggested next step. We ask for
          your email afterwards, not before.
        </p>
        <div class="button-row">
          <a class="button button-paper" href={withBase('/ai-readiness')}>Assess AI readiness</a>
          <a class="button button-inverse" href={withBase('/demo')}>Book a demo</a>
        </div>
        <p class="conversion-micro">9 questions · one workflow · no contact details</p>
      </div>
    </div>
  </section>
</BaseLayout>
