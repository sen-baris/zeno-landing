---
import BaseLayout from '../layouts/BaseLayout.astro';
import BenefitScene from '../components/BenefitScene.astro';
import BusinessCase from '../components/BusinessCase.astro';
import CustomerLogoRail from '../components/CustomerLogoRail.astro';
import GovernanceConsole from '../components/GovernanceConsole.astro';
import PlatformOverview from '../components/PlatformOverview.astro';
import ProductWorkspace from '../components/ProductWorkspace.astro';
import TrustCertifications from '../components/TrustCertifications.astro';
import { businessCaseAssets } from '../lib/claims/business-case-assets';
import { certificationAssets } from '../lib/claims/certification-assets';
import { customerLogoAssets } from '../lib/claims/customer-logo-assets';
import {
  claimRegistry,
  homepageBusinessCaseClaimIds,
  homepageCertificationClaimIds,
  homepageCustomerLogoClaimIds,
  homepageProofClaimIds,
  trustCenterUrl,
} from '../lib/claims/registry';
import { resolveApprovedClaims } from '../lib/claims/public-claims';
import { withBase } from '../lib/routing/base-path';
import {
  adoptionCosts,
  audiences,
  benefits,
  draftHomeCopy,
  operatingShift,
} from '../lib/content/site-content';

const approvedProof = resolveApprovedClaims(claimRegistry, homepageProofClaimIds, 'home.proof');
const approvedCertifications = resolveApprovedClaims(
  claimRegistry,
  homepageCertificationClaimIds,
  'home.trust',
);
const approvedBusinessCase = resolveApprovedClaims(
  claimRegistry,
  homepageBusinessCaseClaimIds,
  'home.business-case',
);
const approvedCustomerLogoClaims = resolveApprovedClaims(
  claimRegistry,
  homepageCustomerLogoClaimIds,
  'home.customer-logos',
);
const customerLogoByClaimId = new Map(customerLogoAssets.map((logo) => [logo.claimId, logo]));
const approvedCustomerLogos = approvedCustomerLogoClaims.map((claim) => {
  const logo = customerLogoByClaimId.get(claim.id);
  if (!logo) throw new Error(`Approved customer logo asset "${claim.id}" is missing.`);
  return logo;
});
---

<BaseLayout
  title="Zeno — Make AI part of everyday work"
  description="Bring AI into everyday work with connected knowledge, specialized agents, repeatable workflows, and visible enterprise governance."
  canonicalPath="/"
>
  <section class="hero section-rule">
    <div class="shell hero-layout">
      <div class="hero-intro">
        <div>
          <h1>{draftHomeCopy.headline}</h1>
        </div>
        <div class="hero-message">
          <p class="hero-subhead">{draftHomeCopy.subhead}</p>
          <div class="hero-action" role="group" aria-label="Hero call to action">
            <a class="button button-primary" href={withBase('/demo')}>Book a demo</a>
          </div>
        </div>
      </div>
      <PlatformOverview />
    </div>
  </section>

  <CustomerLogoRail logos={approvedCustomerLogos} audiences={audiences} proof={approvedProof} />

  <section class="benefits section-rule" id="why" aria-labelledby="benefits-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">Why Zeno</p>
          <h2 id="benefits-title">
            Most enterprises don't have an access problem. They have an adoption problem.
          </h2>
        </div>
        <p>
          Access is straightforward to buy. Adoption is what makes it worth the budget: work people
          recognise, reuse across teams, and a rollout that stays understandable as it grows.
        </p>
      </header>
      <div class="benefit-grid">
        {
          benefits.map((benefit) => (
            <article class="benefit-item" data-reveal>
              <span class="item-number">{benefit.number}</span>
              <h3>{benefit.title}</h3>
              <p>{benefit.body}</p>
              <BenefitScene variant={benefit.scene} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="adoption-cost section-rule" id="cost" aria-labelledby="cost-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">What it costs</p>
          <h2 id="cost-title">Unused AI is not free.</h2>
        </div>
        <p>
          The bill arrives quietly: in budgets nobody can direct, in work that never left the
          spreadsheet, and in the next provider evaluation.
        </p>
      </header>
      <ol class="cost-list">
        {
          adoptionCosts.map((cost) => (
            <li data-reveal>
              <span>{cost.number}</span>
              <h3>{cost.title}</h3>
              <p>{cost.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class="business-case section-rule"
    id="business-case"
    aria-labelledby="business-case-title"
  >
    <div class="shell">
      <header class="section-heading">
        <p class="eyebrow">Business case</p>
        <h2 id="business-case-title">Impact reported by enterprise rollouts.</h2>
      </header>
      <BusinessCase results={approvedBusinessCase} assets={businessCaseAssets} />
    </div>
  </section>

  <section class="platform section-rule" id="platform" aria-labelledby="platform-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">What Zeno brings together</p>
          <h2 id="platform-title">From on-brand presentations to company-wide execution.</h2>
        </div>
        <p>
          Start with one useful agent, extend it into repeatable workflows, and keep adoption
          manageable.
        </p>
      </header>
      <ProductWorkspace />
      <p class="section-more">
        <a class="text-link" href={withBase('/product')}>See how the platform works &rarr;</a>
      </p>
    </div>
  </section>

  <section class="operating-shift section-rule" id="shift" aria-labelledby="shift-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">What changes</p>
          <h2 id="shift-title">The same quarter, run differently.</h2>
        </div>
        <p>
          Nothing here needs a new team or a new process. It needs the work to happen somewhere it
          can be seen.
        </p>
      </header>
      <div class="shift-compare" data-reveal>
        <section class="shift-column shift-today" aria-labelledby="shift-today-title">
          <h3 id="shift-today-title" class="product-label">Today</h3>
          <ul>
            {operatingShift.today.map((line) => <li>{line}</li>)}
          </ul>
        </section>
        <section class="shift-column shift-zeno" aria-labelledby="shift-zeno-title">
          <h3 id="shift-zeno-title" class="product-label">With Zeno</h3>
          <ul>
            {operatingShift.withZeno.map((line) => <li>{line}</li>)}
          </ul>
        </section>
      </div>
    </div>
  </section>

  <section class="adoption-trust section-rule" id="trust" aria-labelledby="trust-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">Trust and control</p>
          <h2 id="trust-title">Scale without giving up control.</h2>
        </div>
        <p>
          Follow how useful work spreads while access, model choice, review, and regional operating
          needs stay visible.
        </p>
      </header>
      <GovernanceConsole />
      <TrustCertifications
        certifications={approvedCertifications}
        assets={certificationAssets}
        trustCenterUrl={trustCenterUrl}
      />
    </div>
  </section>

  <section class="conversion" aria-labelledby="conversion-title">
    <div class="shell conversion-grid">
      <div>
        <p class="eyebrow">AI Readiness Assessment</p>
        <h2 id="conversion-title">Find where AI can become useful first.</h2>
      </div>
      <div>
        <p>
          Answer nine questions about one workflow and get an impact score, readiness score, and
          practical next actions before sharing contact details.
        </p>
        <div class="button-row">
          <a class="button button-paper" href={withBase('/ai-readiness')}>Assess AI readiness</a>
          <a class="button button-inverse" href={withBase('/demo')}>Book a demo</a>
        </div>
        <p class="conversion-micro">9 questions · one workflow · no contact details</p>
      </div>
    </div>
  </section>
</BaseLayout>
