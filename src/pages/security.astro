---
import SecurityWorkspace from '../components/SecurityWorkspace.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { claimRegistry } from '../lib/claims/registry';
import { resolveApprovedClaims } from '../lib/claims/public-claims';
import { securityPageContent } from '../lib/content/security';
import { withBase } from '../lib/routing/base-path';

const resolveSecurityClaim = (id: string, surface: string) =>
  resolveApprovedClaims(claimRegistry, [id], surface)[0]!;

const metadataClaim = resolveSecurityClaim(
  securityPageContent.metadata.claimId,
  'security.metadata',
);
const heroClaim = resolveSecurityClaim(securityPageContent.hero.claimId, 'security.hero');
const assuranceRecords = securityPageContent.assurances.map((assurance) => ({
  ...assurance,
  claim: resolveSecurityClaim(assurance.claimId, 'security.assurance'),
}));
const assuranceAttributions = [...new Set(assuranceRecords.map(({ claim }) => claim.attribution))];
const controlsSummaryClaim = resolveSecurityClaim(
  securityPageContent.controlsSummaryClaimId,
  'security.controls',
);
const controlRecords = securityPageContent.controls.map((control) => ({
  ...control,
  statement: resolveSecurityClaim(control.claimId, 'security.controls').statement,
}));
const controlCaption = controlRecords.map((control) => control.statement).join(' ');
const deploymentClaim = resolveSecurityClaim(
  securityPageContent.deploymentClaimId,
  'security.deployment',
);
const evidenceClaim = resolveSecurityClaim(
  securityPageContent.evidence.claimId,
  'security.evidence',
);
const faqRecords = securityPageContent.faqs.map((faq) => {
  const claims = resolveApprovedClaims(claimRegistry, faq.claimIds, 'security.faq');
  return {
    ...faq,
    claims,
    attributions: [
      ...new Set(
        claims
          .map((claim) => claim.attribution)
          .filter(
            (attribution) =>
              attribution !== 'No public attribution required.' &&
              !assuranceAttributions.includes(attribution),
          ),
      ),
    ],
  };
});

const assuranceKindLabels = {
  certification: 'Certified standard',
  attestation: 'Independent report',
  privacy: 'Privacy framework',
} as const;
const assuranceReviewLabels = {
  certification: 'Review certification',
  attestation: 'Review report',
  privacy: 'Review privacy policy',
} as const;
---

<BaseLayout
  title={securityPageContent.metadata.title}
  description={metadataClaim.statement}
  canonicalPath="/security"
  pageClass="security-page"
>
  <section class="security-hero section-rule" aria-labelledby="security-page-title">
    <div class="shell security-hero-grid">
      <div class="security-hero-copy">
        <p class="eyebrow">{securityPageContent.hero.eyebrow}</p>
        <h1 id="security-page-title">{securityPageContent.hero.title}</h1>
        <p>{heroClaim.statement}</p>
        <div class="button-row">
          <a
            class="button button-primary"
            href={securityPageContent.evidence.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open the Trust Center<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
          <a class="button button-secondary" href={withBase('/demo')}>Book a demo</a>
        </div>
      </div>

      <SecurityWorkspace controls={controlRecords} caption={controlCaption} />
    </div>
  </section>

  <section class="security-assurance section-rule" aria-labelledby="security-assurance-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">Certifications and privacy</p>
          <h2 id="security-assurance-title">Assurance you can verify.</h2>
        </div>
        <p>{assuranceAttributions.join(' ')}</p>
      </header>

      <ul class="security-assurance-grid" data-reveal>
        {
          assuranceRecords.map(({ claim, kind, label }) => (
            <li data-assurance-kind={kind}>
              <div class="security-assurance-mark" aria-hidden="true">
                <svg viewBox="0 0 40 40" focusable="false">
                  <path d="M20 3.5 33.2 8.6v10.6c0 7.4-5.2 13.4-13.2 15.9C12 32.6 6.8 26.6 6.8 19.2V8.6Z" />
                  <path class="security-assurance-check" d="m14.2 19.2 4.1 4.1 7.9-8.3" />
                </svg>
              </div>
              <p class="product-label">{assuranceKindLabels[kind]}</p>
              <h3>{label}</h3>
              <p>{claim.statement}</p>
              {claim.public_url && (
                <a
                  class="text-link"
                  href={kind === 'privacy' ? withBase('/privacy-policy') : claim.public_url}
                  target={kind === 'privacy' ? undefined : '_blank'}
                  rel={kind === 'privacy' ? undefined : 'noopener noreferrer'}
                >
                  {assuranceReviewLabels[kind]}
                  {kind !== 'privacy' && <span class="visually-hidden"> (opens in a new tab)</span>}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="security-controls section-rule" aria-labelledby="security-controls-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">Workspace controls</p>
          <h2 id="security-controls-title">Keep the rules close to the work.</h2>
        </div>
        <p>{controlsSummaryClaim.statement}</p>
      </header>

      <ol class="security-control-grid" data-reveal>
        {
          controlRecords.map((control, index) => (
            <li>
              <span class="item-number">{String(index + 1).padStart(2, '0')}</span>
              <h3>{control.label}</h3>
              <p>{control.statement}</p>
            </li>
          ))
        }
      </ol>

      <div class="security-deployment" data-reveal>
        <p class="product-label">Deployment option</p>
        <p>
          {deploymentClaim.statement}
          <span>{deploymentClaim.attribution}</span>
        </p>
      </div>
    </div>
  </section>

  <section class="security-evidence section-rule" aria-labelledby="security-evidence-title">
    <div class="shell security-evidence-grid">
      <div>
        <p class="eyebrow">Verify the program</p>
        <h2 id="security-evidence-title">Go from summary to evidence.</h2>
        <p>{evidenceClaim.statement}</p>
        <a
          class="button button-paper"
          href={securityPageContent.evidence.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          Open the Trust Center<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>

      <nav class="security-evidence-directory" aria-label="Trust Center directory">
        {
          securityPageContent.evidence.items.map((item, index) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{item.label}</strong>
              <span aria-hidden="true">↗</span>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="security-faq section-rule" aria-labelledby="security-faq-title">
    <div class="shell security-faq-grid">
      <header>
        <p class="eyebrow">Security FAQ</p>
        <h2 id="security-faq-title">What buyers ask first.</h2>
      </header>

      <div class="security-faq-list">
        {
          faqRecords.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <div>
                {faq.claims.map((claim) => (
                  <p>{claim.statement}</p>
                ))}
                {faq.attributions.map((attribution) => (
                  <p class="security-faq-attribution">{attribution}</p>
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="conversion security-conversion" aria-labelledby="security-conversion-title">
    <div class="shell conversion-grid">
      <div>
        <p class="eyebrow">{securityPageContent.conversion.eyebrow}</p>
        <h2 id="security-conversion-title">{securityPageContent.conversion.title}</h2>
      </div>
      <div>
        <p>{securityPageContent.conversion.description}</p>
        <div class="button-row">
          <a class="button button-paper" href={withBase('/demo')}>Book a demo</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
