---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdoptionGap from '../components/AdoptionGap.astro';
import PlatformOverview from '../components/PlatformOverview.astro';
import GovernanceConsole from '../components/GovernanceConsole.astro';
import ProductWorkspace from '../components/ProductWorkspace.astro';
import WorkflowRun from '../components/WorkflowRun.astro';
import { withBase } from '../lib/routing/base-path';
import { platformPillars, workflowExamples } from '../lib/content/site-content';
---

<BaseLayout
  title="Product — Zeno"
  description="How Zeno works: connected company knowledge, specialized agents, repeatable workflows that run on a schedule, and governance that stays visible as adoption grows."
  canonicalPath="/product"
>
  <section class="page-intro section-rule">
    <div class="shell narrow-shell">
      <h1>Connect. Equip. Run. Govern.</h1>
      <p>
        Four steps from the systems your teams already use to work that runs on its own and still
        gets checked by a person.
      </p>
    </div>
    <div class="shell">
      <PlatformOverview />
    </div>
  </section>

  <section class="operating-model section-rule" aria-labelledby="runs-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">Agents</p>
          <h2 id="runs-title">An agent built for one job.</h2>
        </div>
        <p>
          Give it the brief, the sources it may use, and the template it has to follow. It hands the
          result back for review.
        </p>
      </header>
      <ProductWorkspace />
      <div class="workflow-examples" aria-label="Example workflows">
        <p class="product-label">Where teams begin</p>
        <ul>
          {workflowExamples.map((workflow) => <li>{workflow}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="platform section-rule" aria-labelledby="runs-schedule-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">Workflows</p>
          <h2 id="runs-schedule-title">The report builds itself. You still sign it off.</h2>
        </div>
        <p>
          Every Monday it collects the data, prepares it, and drafts the summary. Then it stops and
          waits for a person.
        </p>
      </header>
      <WorkflowRun />
    </div>
  </section>

  <section class="platform section-rule" aria-labelledby="pillars-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">How it scales</p>
          <h2 id="pillars-title">Start with one agent. Add the next when it has earned it.</h2>
        </div>
        <p>The same three parts hold whether one team uses it or the whole company does.</p>
      </header>
      <div class="platform-pillars">
        {
          platformPillars.map((pillar) => (
            <article data-reveal>
              <span class="pillar-label">{pillar.label}</span>
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="adoption-trust section-rule" aria-labelledby="adoption-title">
    <div class="shell">
      <header class="section-heading split-heading">
        <div>
          <p class="eyebrow">What to measure</p>
          <h2 id="adoption-title">Adoption you can actually measure.</h2>
        </div>
        <p>
          What to watch at each stage, so you know whether it is taking hold before you widen it.
        </p>
      </header>
      <ol class="adoption-timeline" aria-label="90-day adoption observation framework">
        <li data-reveal>
          <span>30</span>
          <div>
            <small>days</small>
            <h3>Find repeat use</h3>
            <p>See which teams return after their first interaction.</p>
          </div>
        </li>
        <li data-reveal>
          <span>60</span>
          <div>
            <small>days</small>
            <h3>Spread what works</h3>
            <p>Follow reuse of shared agents and connected knowledge.</p>
          </div>
        </li>
        <li data-reveal>
          <span>90</span>
          <div>
            <small>days</small>
            <h3>Scale with control</h3>
            <p>See which recurring work is ready for governed execution.</p>
          </div>
        </li>
      </ol>
      <AdoptionGap />
      <GovernanceConsole />
    </div>
  </section>

  <section class="conversion" aria-labelledby="product-cta-title">
    <div class="shell conversion-grid">
      <div>
        <p class="eyebrow">Start with one workflow</p>
        <h2 id="product-cta-title">See it against your own work.</h2>
      </div>
      <div>
        <p>
          Bring a workflow your team runs every week and we will walk through how it would be set
          up, what it would run on, and who would sign it off.
        </p>
        <div class="button-row">
          <a class="button button-paper" href={withBase('/demo')}>Book a demo</a>
          <a class="button button-inverse" href={withBase('/ai-readiness')}>Assess AI readiness</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
