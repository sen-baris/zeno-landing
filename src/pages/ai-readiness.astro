---
import ReadinessAssessment from '../components/islands/ReadinessAssessment';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI Readiness Assessment | Zeno"
  description="Score one enterprise workflow across impact and readiness, then receive a practical starting point."
  canonicalPath="/ai-readiness"
  pageClass="assessment-page"
>
  <section class="page-intro section-rule">
    <div class="shell narrow-shell">
      <p class="eyebrow">AI Readiness Assessment</p>
      <h1>Find the right first workflow.</h1>
      <p>
        Nine questions separate attractive ideas from workable starting points. You’ll see your
        result before we ask for contact details.
      </p>
    </div>
  </section>
  <section class="interactive-section">
    <div class="shell narrow-shell">
      <ReadinessAssessment client:only="react">
        <div class="island-fallback" slot="fallback" role="status">
          Loading the assessment. If it does not start, enable JavaScript and reload.
        </div>
      </ReadinessAssessment>
    </div>
  </section>
</BaseLayout>
