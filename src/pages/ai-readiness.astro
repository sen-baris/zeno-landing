---
import '../styles/global.css';
import { withBase } from '../lib/routing/base-path';

const destination = withBase('/pricing');
const canonical = new URL(destination, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Continue to the Zeno business case." />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <title>Continue to the business case | Zeno</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <main class="shell narrow-shell error-page">
      <h1>Continue to the business case.</h1>
      <p>The business-case calculator is now the place to estimate work across your team.</p>
      <a class="button button-ink" href={destination}>Open the business case</a>
    </main>
  </body>
</html>
