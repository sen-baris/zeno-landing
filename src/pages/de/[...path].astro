---
import HomePage from '../../components/pages/HomePage.astro';
import ProductPage from '../../components/pages/ProductPage.astro';
import PricingPage from '../../components/pages/PricingPage.astro';
import DemoPage from '../../components/pages/DemoPage.astro';
import SecurityPage from '../../components/pages/SecurityPage.astro';
import SolutionsPage from '../../components/pages/SolutionsPage.astro';
import SolutionPage from '../../components/pages/SolutionPage.astro';
import CustomerStoryPage from '../../components/pages/CustomerStoryPage.astro';
import { getAllLocalizedRouteEntries, type RouteReference } from '../../lib/i18n/routes';
import { solutionBySlug } from '../../lib/content/solutions';
import {
  customerStoryDrafts,
  selectCustomerStoriesForMode,
  resolveCustomerProofMode,
} from '../../lib/content/customer-stories';
import { assertGermanClaimsApprovedForPublication } from '../../lib/i18n/de-claims';

interface Props {
  reference: RouteReference;
}
export function getStaticPaths() {
  if (import.meta.env.CONTENT_MODE === 'production') assertGermanClaimsApprovedForPublication();
  return getAllLocalizedRouteEntries()
    .filter(({ locale }) => locale === 'de')
    .map(({ path, reference }) => ({
      params: { path: path === '/de/' ? undefined : path.replace(/^\/de\//, '') },
      props: { reference },
    }));
}
const { reference } = Astro.props;
const staticPages = {
  home: HomePage,
  product: ProductPage,
  pricing: PricingPage,
  demo: DemoPage,
  security: SecurityPage,
  solutions: SolutionsPage,
};
const StaticPage =
  reference.kind === 'static' && reference.key in staticPages
    ? staticPages[reference.key as keyof typeof staticPages]
    : undefined;
const solution = reference.kind === 'solution' ? solutionBySlug(reference.slug) : undefined;
const story =
  reference.kind === 'customer'
    ? selectCustomerStoriesForMode(customerStoryDrafts, resolveCustomerProofMode()).find(
        (story) => story.slug === reference.slug,
      )
    : undefined;
if (!StaticPage && !solution && !story)
  throw new Error('The German route has no complete page composition.');
---

{StaticPage && <StaticPage locale="de" />}
{solution && <SolutionPage locale="de" solution={solution} />}
{story && <CustomerStoryPage locale="de" story={story} />}
