---
import BusinessCaseCalculator from '../../components/islands/BusinessCaseCalculator';
import DemoForm from '../../components/islands/DemoForm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { customerLogoAssets } from '../../lib/claims/customer-logo-assets';
import {
  customerStoryDrafts,
  customerVoiceDrafts,
  resolveCustomerProofMode,
  selectCustomerStoriesForMode,
} from '../../lib/content/customer-stories';
import { solutionBySlug, solutions } from '../../lib/content/solutions';
import {
  germanStaticPages,
  getGermanCustomerStory,
  getGermanSolution,
} from '../../lib/i18n/de-content';
import { assertGermanClaimsApprovedForPublication } from '../../lib/i18n/de-claims';
import {
  getAllLocalizedRouteEntries,
  getLocalizedPath,
  type RouteReference,
  type SolutionSlug,
} from '../../lib/i18n/routes';
import { createLocalizedSeo } from '../../lib/i18n/seo';
import { withBase } from '../../lib/routing/base-path';

interface Props {
  reference: RouteReference;
}

export function getStaticPaths() {
  if (import.meta.env.CONTENT_MODE === 'production') {
    assertGermanClaimsApprovedForPublication();
  }

  return getAllLocalizedRouteEntries()
    .filter(({ locale }) => locale === 'de')
    .map(({ path, reference }) => ({
      params: { path: path === '/de/' ? undefined : path.replace(/^\/de\//, '') },
      props: { reference },
    }));
}

const { reference } = Astro.props;
const seo = createLocalizedSeo(reference, 'de');
const demoPath = getLocalizedPath({ kind: 'static', key: 'demo' }, 'de')!;
const productPath = getLocalizedPath({ kind: 'static', key: 'product' }, 'de')!;
const homePath = getLocalizedPath({ kind: 'static', key: 'home' }, 'de')!;

const staticPage = reference.kind === 'static' ? germanStaticPages[reference.key] : undefined;
const sourceSolution = reference.kind === 'solution' ? solutionBySlug(reference.slug) : undefined;
const solution = sourceSolution ? getGermanSolution(sourceSolution) : undefined;
const sourceStory =
  reference.kind === 'customer'
    ? selectCustomerStoriesForMode(customerStoryDrafts, resolveCustomerProofMode()).find(
        (candidate) => candidate.slug === reference.slug,
      )
    : undefined;
const story = sourceStory ? getGermanCustomerStory(sourceStory) : undefined;

if (!staticPage && !solution && !story) throw new Error('German route content is missing.');

const sourceLogo = sourceStory
  ? customerLogoAssets.find((asset) => asset.claimId === sourceStory.logoClaimId)
  : undefined;
const sourceVoice = sourceStory?.quoteId
  ? customerVoiceDrafts.find((voice) => voice.id === sourceStory.quoteId)
  : undefined;
const solutionStorySlug =
  sourceSolution?.customerProof.kind === 'story'
    ? sourceSolution.customerProof.storySlug
    : undefined;
const pageTitle =
  staticPage?.title ?? (solution ? solution.eyebrow + ' | Zeno' : story!.title + ' | Zeno');
const pageDescription = staticPage?.description ?? solution?.metaDescription ?? story!.summary;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  seo={seo}
  pageClass={story ? 'customer-story-page' : solution ? 'solution-page' : 'localized-page'}
>
  {
    staticPage && (
      <>
        <section class="page-intro section-rule" aria-labelledby="localized-page-title">
          <div class="shell narrow-shell">
            <p class="eyebrow">{staticPage.eyebrow}</p>
            <h1 id="localized-page-title">{staticPage.headline}</h1>
            <p>{staticPage.intro}</p>
            {reference.kind === 'static' && reference.key !== 'demo' && (
              <a class="button button-primary" href={withBase(demoPath)}>
                Demo buchen
              </a>
            )}
          </div>
        </section>

        {reference.kind === 'static' && reference.key === 'pricing' && (
          <section class="pricing-hero section-rule" aria-label="Business-Case-Rechner">
            <div class="shell pricing-calculator-column">
              <script is:inline>
                document.documentElement.classList.add('has-pricing-calculator');
              </script>
              <BusinessCaseCalculator
                client:load
                locale="de"
                title="Einen ersten Richtwert berechnen."
                pilotStatement="Ein fokussierter Pilot schafft eine überprüfbare Grundlage für die weitere Einführung."
                pilotMethod="Die Pilotgröße nutzt 20 Prozent des Teams, gerundet auf ganze Personen. Mindestens fünf Personen, wenn das Team groß genug ist, höchstens 20 und nie mehr als die eingegebene Teamgröße."
                disclaimer="Schätzungen dienen nur der Planung und basieren vollständig auf den Eingaben. Daraus entstehen keine garantierte Zeitersparnis, kein garantierter finanzieller Nutzen und kein endgültiger Zeno-Preis."
                privacyStatement="Alle Angaben bleiben in diesem Browser. Es werden keine Daten gesendet oder gespeichert."
              />
              <noscript>
                <div class="pricing-calculator-fallback">
                  <p class="product-label">Rechenweg</p>
                  <h2>Die Schätzung manuell berechnen.</h2>
                  <p>
                    Personen × gemeinsame Wochenstunden × zurückgewonnener Zeitanteil ×
                    Arbeitswochen ergibt die jährlich zurückgewonnenen Stunden. Diese Stunden werden
                    mit dem Planungswert pro Stunde multipliziert.
                  </p>
                  <p>
                    Schätzungen dienen nur der Planung und garantieren weder Zeitersparnis noch
                    finanziellen Nutzen oder einen endgültigen Zeno-Preis.
                  </p>
                  <a class="button button-primary" href={withBase(demoPath)}>
                    Demo buchen
                  </a>
                </div>
              </noscript>
            </div>
          </section>
        )}

        {reference.kind === 'static' && reference.key === 'demo' && (
          <section class="demo-conversion section-rule" aria-label="Demo-Anfrage">
            <div class="shell demo-conversion-grid">
              <header class="demo-conversion-copy">
                <p class="eyebrow">Demo buchen</p>
                <h2>Ein vorbereitetes Gespräch.</h2>
                <p>
                  Ein kurzer Überblick über Team, Systeme und Kontrollen reicht für die
                  Vorbereitung.
                </p>
              </header>
              <DemoForm
                client:load
                locale="de"
                privacyAcknowledgement="Ich stimme zu, dass Zeno diese Angaben verwenden darf, um auf meine Anfrage zu antworten."
              />
            </div>
          </section>
        )}

        {reference.kind === 'static' && reference.key === 'solutions' && (
          <section class="solution-index section-rule" aria-labelledby="german-solutions-title">
            <div class="shell narrow-shell">
              <h2 id="german-solutions-title" class="visually-hidden">
                Branchen
              </h2>
              <ul class="solution-index-list">
                {solutions.map((entry, index) => {
                  const translated = getGermanSolution(entry);
                  const path = getLocalizedPath(
                    { kind: 'solution', slug: entry.slug as SolutionSlug },
                    'de',
                  )!;
                  return (
                    <li>
                      <a href={withBase(path)}>
                        <span class="item-number">{String(index + 1).padStart(2, '0')}</span>
                        <span class="solution-index-copy">
                          <b>{translated.navLabel}</b>
                          <small>{translated.summary}</small>
                        </span>
                        <span class="solution-index-go" aria-hidden="true">
                          →
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </section>
        )}

        {staticPage.sections.map((section, index) => (
          <section
            class="solution-work section-rule"
            id={
              reference.kind === 'static' && reference.key === 'home' && index === 0
                ? 'why'
                : undefined
            }
            aria-labelledby={'de-static-section-' + index}
          >
            <div class="shell">
              <header class="section-heading split-heading">
                <div>
                  <p class="eyebrow">{section.eyebrow}</p>
                  <h2 id={'de-static-section-' + index}>{section.title}</h2>
                </div>
                <div>
                  {section.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  {section.points && (
                    <ul>
                      {section.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </header>
            </div>
          </section>
        ))}

        {reference.kind === 'static' && reference.key === 'security' && (
          <section class="conversion" aria-labelledby="security-de-cta">
            <div class="shell conversion-grid">
              <div>
                <p class="eyebrow">Anforderungen prüfen</p>
                <h2 id="security-de-cta">Sicherheitsfragen direkt klären.</h2>
              </div>
              <div>
                <p>
                  Anforderungen an Zugriff, Hosting und Prüfung werden dem Workspace zugeordnet.
                </p>
                <div class="button-row">
                  <a class="button button-paper" href={withBase(demoPath)}>
                    Demo buchen
                  </a>
                  <a
                    class="button button-inverse"
                    href="https://trust.textcortex.com/home"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Trust Center öffnen
                    <span class="visually-hidden"> (öffnet in einem neuen Tab)</span>
                  </a>
                </div>
              </div>
            </div>
          </section>
        )}
      </>
    )
  }

  {
    solution && sourceSolution && (
      <>
        <section class="page-intro solution-intro section-rule">
          <div class="shell narrow-shell">
            <p class="eyebrow">{solution.eyebrow}</p>
            <h1>{solution.headline}</h1>
            <p>{solution.subhead}</p>
            <div class="button-row">
              <a class="button button-primary" href={withBase(demoPath)}>
                Demo buchen
              </a>
              <a class="text-link" href={withBase(productPath)}>
                Produkt ansehen →
              </a>
            </div>
          </div>
        </section>

        <section class="solution-product section-rule" aria-label="Produktablauf">
          <div class="shell">
            <ol class="solution-journey">
              {solution.journey.map((step, index) => (
                <li>
                  <span class="solution-journey-number">{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <h2>{step.title}</h2>
                    <p>{step.description}</p>
                  </div>
                </li>
              ))}
            </ol>
            <div class="solution-control-panel">
              <header>
                <div>
                  <p class="product-label">{solution.agents[0]?.name}</p>
                  <p>{solution.workspace.task}</p>
                </div>
              </header>
              <h3>{solution.workspace.resultTitle}</h3>
              <ul>
                {solution.workspace.resultItems.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p>{solution.workspace.reviewer} prüft das Ergebnis.</p>
            </div>
          </div>
        </section>

        {solutionStorySlug &&
          (() => {
            const proofStory = customerStoryDrafts.find(
              (candidate) => candidate.slug === solutionStorySlug,
            );
            if (!proofStory) return null;
            const translatedProof = getGermanCustomerStory(proofStory);
            const proofPath = getLocalizedPath({ kind: 'customer', slug: proofStory.slug }, 'de')!;
            return (
              <section class="solution-customer-story section-rule">
                <div class="shell">
                  <p class="eyebrow">Kundenstory</p>
                  <h2>{translatedProof.title}</h2>
                  <p>{translatedProof.summary}</p>
                  <a class="text-link" href={withBase(proofPath)}>
                    Kundenstory lesen →
                  </a>
                </div>
              </section>
            );
          })()}

        {sourceSolution.customerProof.kind === 'quote' && (
          <section class="solution-customer-story section-rule">
            <div class="shell">
              <p class="eyebrow">Kundenstimme</p>
              <blockquote lang="en">
                “I only need to train my colleagues on one tool that continuously develops within
                the familiar interface.”
              </blockquote>
              <p>Managing Partner, Frommer Legal</p>
            </div>
          </section>
        )}

        <section class="solution-work section-rule" aria-labelledby="solution-de-work">
          <div class="shell">
            <header class="section-heading split-heading">
              <div>
                <p class="eyebrow">Die Arbeit</p>
                <h2 id="solution-de-work">{solution.workTitle}</h2>
              </div>
              <p>{solution.workBody}</p>
            </header>
            <div class="solution-agent-grid">
              {solution.agents.map((agent) => (
                <article>
                  <h3>{agent.name}</h3>
                  <p>{agent.does}</p>
                  <p class="product-label">{agent.from}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="solution-walls section-rule" aria-labelledby="solution-de-controls">
          <div class="shell">
            <header class="section-heading split-heading">
              <div>
                <p class="eyebrow">Kontrollierter Workspace</p>
                <h2 id="solution-de-controls">{solution.wallsTitle}</h2>
              </div>
              <p>{solution.wallsBody}</p>
            </header>
            <div class="solution-control-panel">
              <dl>
                {solution.controls.map((control) => (
                  <div>
                    <dt>{control.label}</dt>
                    <dd>{control.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </section>

        <section class="solution-questions section-rule" aria-labelledby="solution-de-questions">
          <div class="shell">
            <header class="section-heading">
              <p class="eyebrow">Vor dem Start</p>
              <h2 id="solution-de-questions">{solution.questionsTitle}</h2>
            </header>
            <dl class="solution-question-list">
              {solution.questions.map((entry) => (
                <div>
                  <dt>{entry.question}</dt>
                  <dd>{entry.answer}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>

        <section class="conversion">
          <div class="shell conversion-grid">
            <div>
              <p class="eyebrow">Ein Workflow, dann der nächste</p>
              <h2>{solution.closing}</h2>
            </div>
            <div>
              <p>
                Ein wiederkehrendes Dokument reicht. Wir zeigen den Agenten, den Unternehmenskontext
                und die verantwortliche Prüfung.
              </p>
              <a class="button button-paper" href={withBase(demoPath)}>
                Demo buchen
              </a>
            </div>
          </div>
        </section>
      </>
    )
  }

  {
    story && sourceStory && sourceLogo && (
      <article class="customer-story">
        <header class="customer-story-hero section-rule">
          <div class="shell customer-story-hero-grid">
            <div class="customer-story-identity">
              <a class="customer-story-back" href={withBase(homePath)}>
                ← Kundenstories
              </a>
              <div class="customer-story-logo-lockup">
                <img
                  src={withBase(sourceLogo.src)}
                  alt={sourceLogo.name}
                  width="400"
                  height="400"
                />
              </div>
            </div>
            <div>
              <p class="eyebrow">Kundenstory</p>
              <h1>{story.title}</h1>
              <p class="customer-story-summary">{story.summary}</p>
            </div>
          </div>
        </header>

        <section class="customer-story-results section-rule" aria-labelledby="results-de-title">
          <div class="shell">
            <p class="eyebrow" id="results-de-title">
              Berichtete Ergebnisse
            </p>
            <dl>
              {story.results.map((result) => (
                <div>
                  <dt>{result.value}</dt>
                  <dd>{result.label}</dd>
                  <dd class="customer-story-qualifier">{result.qualifier}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>

        <section class="customer-story-article section-rule" aria-label="Kundenstory">
          <div class="shell customer-story-article-list">
            {story.sections.map((section, index) => (
              <section
                class="customer-story-article-section"
                aria-labelledby={'story-de-section-' + index}
              >
                <header>
                  <p class="product-label">{section.label}</p>
                  <h2 id={'story-de-section-' + index}>{section.heading}</h2>
                </header>
                <div class="customer-story-article-copy">
                  {section.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  {section.points && (
                    <ul>
                      {section.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </section>
            ))}
          </div>
        </section>

        {sourceVoice && (
          <section class="customer-story-quote section-rule" aria-label="Kundenzitat">
            <div class="shell">
              <figure lang="en">
                <blockquote>
                  <p>“{sourceVoice.verbatimExcerpt}”</p>
                </blockquote>
                <figcaption>{sourceVoice.attribution}</figcaption>
              </figure>
            </div>
          </section>
        )}

        <footer class="customer-story-footer">
          <div class="shell customer-story-footer-grid customer-story-footer-grid-single">
            <div>
              <h2>Einen Workflow in die tägliche Arbeit bringen.</h2>
              <p>
                Ein wiederkehrender Prozess reicht. Wir ordnen Unternehmenskontext, Agentenarbeit
                und menschliche Prüfung zu.
              </p>
              <a class="button button-inverse" href={withBase(demoPath)}>
                Demo buchen
              </a>
            </div>
          </div>
        </footer>
      </article>
    )
  }
</BaseLayout>
