---
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-serif/400.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MotionRuntime from '../components/MotionRuntime.astro';
import { localeDefinitions } from '../lib/i18n/locales';
import type { LocalizedSeo } from '../lib/i18n/seo';
import { sharedUiCopy } from '../lib/i18n/ui';
import { withBase } from '../lib/routing/base-path';

interface Props {
  title: string;
  description: string;
  seo: LocalizedSeo;
  pageClass?: string;
  noIndex?: boolean;
}

const { title, description, seo, pageClass = '', noIndex = false } = Astro.props;
const canonical = new URL(withBase(seo.canonicalPath), Astro.site);
const copy = sharedUiCopy[seo.locale];
const localeDefinition = localeDefinitions[seo.locale];
const alternateUrls = seo.hreflangLinks.map((alternate) => ({
  hreflang: alternate.hreflang,
  href: new URL(withBase(alternate.path), Astro.site),
}));

// A shared preview is not a launch. Keep unlaunched brand, draft copy, and customer logos out of
// search indexes until the production release gate has been satisfied.
const isPreviewDeploy = import.meta.env.PUBLIC_PREVIEW_DEPLOY === 'true';
---

<!doctype html>
<html lang={seo.locale} dir={localeDefinition.direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F7F3EE" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="description" content={description} />
    {
      (noIndex || !seo.isPublished || isPreviewDeploy) && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <link rel="canonical" href={canonical} />
    {
      alternateUrls.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zeno" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <MotionRuntime />
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">{copy.skipLink}</a>
    <Header locale={seo.locale} switcherLinks={seo.switcherLinks} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={seo.locale} />
  </body>
</html>
